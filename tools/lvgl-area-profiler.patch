+#if LV_USE_PROFILER
+/// One-shot capture window for LVGL's builtin profiler.
+///
+/// HELIX_LVGL_PROFILE=<delay_s>:<run_s> arms it: the profiler initializes
+/// disabled, switches on <delay_s> after init, records for <run_s>, then
+/// disables and dumps the whole trace buffer to stderr in one pass. Picking
+/// <delay_s> so the window lands on a running screensaver keeps the buffer off
+/// its auto-flush-on-full path, which would dump mid-capture. The dump goes to
+/// stderr as raw trace text; it is instrument output, not app logging.
+namespace {
+
+uint64_t profiler_tick_ns() {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<uint64_t>(ts.tv_sec) * 1000000000ull + static_cast<uint64_t>(ts.tv_nsec);
+}
+
+double g_profile_delay_s = 0.0;
+double g_profile_run_s = 2.0;
+long g_profile_bytes_dumped = 0;
+
+void profiler_flush_stderr(const char* buf) {
+    fputs(buf, stderr);
+    g_profile_bytes_dumped += static_cast<long>(strlen(buf));
+}
+
+void profile_capture_timer_cb(lv_timer_t* timer) {
+    auto* started_ns = static_cast<uint64_t*>(timer->user_data);
+    const double elapsed_s = static_cast<double>(profiler_tick_ns() - *started_ns) / 1e9;
+    static double stop_at = 0.0;
+    static bool capturing = false;
+    if (!capturing && elapsed_s >= g_profile_delay_s) {
+        capturing = true;
+        lv_profiler_builtin_set_enable(true);
+        spdlog::info("[DisplayManager] LVGL profiler capture started");
+        stop_at = g_profile_delay_s + g_profile_run_s;
+    } else if (capturing && elapsed_s >= stop_at) {
+        lv_profiler_builtin_set_enable(false);
+        g_profile_bytes_dumped = 0;
+        lv_profiler_builtin_flush();
+        spdlog::info("[DisplayManager] LVGL profiler capture done: {} bytes of trace on stderr",
+                     g_profile_bytes_dumped);
+        lv_timer_delete(timer);
+        delete started_ns;
+    }
+}
+
+} // namespace
+
+void arm_lvgl_profile_capture() {
+    const char* spec = std::getenv("HELIX_LVGL_PROFILE");
+    if (!spec || !spec[0]) {
+        return;
+    }
+    char* end = nullptr;
+    const double delay_s = std::strtod(spec, &end);
+    const double run_s = (end && *end == ':') ? std::strtod(end + 1, &end) : -1.0;
+    if (run_s <= 0 || delay_s < 0 || run_s > 60) {
+        spdlog::warn("[DisplayManager] HELIX_LVGL_PROFILE='{}' is not <delay_s>:<run_s>, ignoring",
+                     spec);
+        return;
+    }
+    g_profile_delay_s = delay_s;
+    g_profile_run_s = run_s;
+
+    lv_profiler_builtin_config_t cfg;
+    lv_profiler_builtin_config_init(&cfg);
+    // Must stay in sync with LV_PROFILER_BUILTIN_BUF_SIZE in lv_conf.h: the
+    // buffer has to hold one whole capture window without wrapping.
+    cfg.buf_size = LV_PROFILER_BUILTIN_BUF_SIZE;
+    cfg.tick_per_sec = 1000000000; // ns ticks; the default lv_tick_get() is 1 ms
+    cfg.tick_get_cb = profiler_tick_ns;
+    cfg.flush_cb = profiler_flush_stderr;
+    lv_profiler_builtin_init(&cfg);
+    lv_profiler_builtin_set_enable(false);
+
+    auto* started_ns = new uint64_t(profiler_tick_ns());
+    lv_timer_t* timer = lv_timer_create(profile_capture_timer_cb, 100, started_ns);
+    lv_timer_set_repeat_count(timer, -1);
+    spdlog::info("[DisplayManager] LVGL profiler armed: capture {}s..{}s after init", delay_s,
+                 delay_s + run_s);
+}
+#endif
+
 } // namespace
 
