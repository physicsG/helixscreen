# LVGL per-area render profiler (dev instrumentation, NOT for main)
#
# Turns "where does the per-invalidated-area cost go" into a per-tag ns profile.
# Used 2026-09-17 to decompose the AD5X-vs-K1C 1.65x render gap into
# 1.22x dynamic-linkage overhead + 1.40x residual.
#
# DO NOT MERGE: lv_conf.h here sets LV_USE_PROFILER 1, which would enable the
# profiler in shipping builds. Apply to a worktree, measure, discard.
#
# Apply:  git apply lvgl-area-profiler.patch
# Run:    HELIX_LVGL_PROFILE=<delay_s>:<run_s>   e.g. 15:1.2
#         Trace goes to stderr as tracing_mark_write B|1|<tag> lines.
#
# NOT included: tag sites inside lib/lvgl (a submodule managed by patches/,
# so a diff there is entangled with our own patches). Re-add by hand:
#   lib/lvgl/src/drivers/display/fb/lv_linux_fbdev.c  flush_cb  -> fb_flush, fb_rotate
#   lib/lvgl/src/core/lv_refr.c                       draw_buf_flush -> dbflush
# LVGL's own refr_area / lv_draw_image / dispatch tags need no edit.
#
# Gotchas that cost time:
#   - Default trace buffer is 16 KB and wraps mid-frame at ~60 areas; use 2 MB.
#   - Default lv_tick_get() is 1 ms; use clock_gettime(CLOCK_MONOTONIC) ns ticks.
#   - The profiler roughly DOUBLES CPU while enabled, so compare ratios between
#     instrumented runs, never against an un-instrumented cost model.
#   - Report p50, not mean: a buffer flush pauses the thread and poisons means.
diff --git a/lv_conf.h b/lv_conf.h
index 019245264..469c29c3b 100644
--- a/lv_conf.h
+++ b/lv_conf.h
@@ -1021,17 +1021,20 @@
 #endif /*LV_USE_SYSMON*/
 
 /*1: Enable the runtime performance profiler*/
-#define LV_USE_PROFILER 0
+#define LV_USE_PROFILER 1
 #if LV_USE_PROFILER
     /*1: Enable the built-in profiler*/
     #define LV_USE_PROFILER_BUILTIN 1
     #if LV_USE_PROFILER_BUILTIN
         /*Default profiler trace buffer size*/
-        #define LV_PROFILER_BUILTIN_BUF_SIZE (16 * 1024)     /*[bytes]*/
+        #define LV_PROFILER_BUILTIN_BUF_SIZE (2 * 1024 * 1024)     /*[bytes]*/
     #endif
 
-    /*Header to include for the profiler*/
-    #define LV_PROFILER_INCLUDE "lvgl/src/misc/lv_profiler_builtin.h"
+    /*Header to include for the profiler. Included only by lv_profiler.h, which
+     * sits in the same directory, so a bare filename resolves under every
+     * build's include flags (the splash build has no path that spells
+     * "lvgl/src/...").*/
+    #define LV_PROFILER_INCLUDE "lv_profiler_builtin.h"
 
     /*Profiler start point function*/
     #define LV_PROFILER_BEGIN    LV_PROFILER_BUILTIN_BEGIN
@@ -1044,6 +1047,17 @@
 
     /*Profiler end point function with custom tag*/
     #define LV_PROFILER_END_TAG   LV_PROFILER_BUILTIN_END_TAG
+
+    /*Keep only per-area categories: event/timer/font tags fire orders of
