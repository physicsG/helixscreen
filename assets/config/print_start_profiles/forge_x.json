{
  "name": "Forge-X Mod",
  "description": "FlashForge AD5M / AD5M Pro with the Forge-X firmware mod. 1.4.x narrates through the operation_context status object (a stack of contexts, each with its own state); older versions print '// State:' lines.",
  "progress_mode": "weighted",
  "signal_formats": [
    {
      "prefix": "// State: ",
      "mappings": {
        "PREPARING...":         { "phase": "INITIALIZING",    "message": "Preparing...",             "progress": 3 },
        "MD5 CHECK":            { "phase": "INITIALIZING",    "message": "Verifying file...",        "progress": 5 },
        "HOMING...":            { "phase": "HOMING",          "message": "Homing axes...",           "progress": 10 },
        "PREPARE CLEANING...":  { "phase": "CLEANING",        "message": "Preparing to clean...",    "progress": 15 },
        "HEATING...":           { "phase": "HEATING_BED",     "message": "Heating...",               "progress": 25 },
        "CLEANING START SOON":  { "phase": "CLEANING",        "message": "Starting nozzle clean...", "progress": 30 },
        "CLEANING...":          { "phase": "CLEANING",        "message": "Cleaning nozzle...",       "progress": 38 },
        "COOLING DOWN...":      { "phase": "CLEANING",        "message": "Cooling for probing...",   "progress": 45 },
        "FINISHING CLEANING...":{ "phase": "CLEANING",        "message": "Finishing clean...",        "progress": 55 },
        "DONE!":                { "phase": "CLEANING",        "message": "Nozzle clean complete",    "progress": 57 },
        "KAMP LEVELING...":     { "phase": "BED_MESH",        "message": "Creating bed mesh...",     "progress": 60 },
        "WAIT FOR TEMPERATURE...": { "phase": "HEATING_NOZZLE", "message": "Reheating...",           "progress": 82 },
        "KAMP PRIMING...":      { "phase": "PURGING",         "message": "Priming nozzle...",        "progress": 90 },
        "PRINTING...":          { "phase": "COMPLETE",         "message": "Starting print...",        "progress": 100 }
      }
    }
  ],
  "response_patterns": [
    { "pattern": "^info Cleaning nozzle with a priming line", "phase": "PURGING", "message": "Priming nozzle...", "weight": 10 },
    { "pattern": "^// Clean to X:", "phase": "CLEANING", "message": "Cleaning nozzle...", "weight": 20 },
    { "pattern": "// Wait bed temperature to reach (\\d+)", "phase": "HEATING_BED", "message": "Heating bed to $1°C...", "weight": 15 }
  ],
  "phase_object": {
    "object": "operation_context",
    "field": "current_state",
    "context_field": "context_types"
  },
  "state_patterns": [
    { "pattern": "^print/PRINTING$", "phase": "COMPLETE", "message": "Starting print...", "weight": 100 },
    { "pattern": "^print/PRIMING$", "phase": "PURGING", "message": "Priming nozzle...", "weight": 10 },
    { "pattern": "^print/CHECKING FILE$", "phase": "INITIALIZING", "message": "Verifying file...", "weight": 3 },
    { "pattern": "^[a-z_]+/HOMING$", "phase": "HOMING", "message": "Homing...", "weight": 5 },
    { "pattern": "^(kamp|bed_level)/LEVELING$", "phase": "BED_MESH", "message": "Creating bed mesh...", "weight": 25 },
    { "pattern": "^mesh_validation/CHECKING MESH$", "phase": "BED_MESH", "message": "Validating bed mesh...", "weight": 25, "counts_probes": false },
    { "pattern": "^nozzle_clean/PREPARING TO CLEAN$", "phase": "CLEANING", "message": "Preparing to clean...", "weight": 20 },
    { "pattern": "^nozzle_clean/CLEANING$", "phase": "CLEANING", "message": "Cleaning nozzle...", "weight": 20 },
    { "pattern": "^nozzle_clean/COOLING NOZZLE$", "phase": "CLEANING", "message": "Cooling for probing...", "weight": 20 },
    { "pattern": "^nozzle_clean/FINISHING$", "phase": "CLEANING", "message": "Finishing clean...", "weight": 20 },
    { "pattern": "^(kamp|bed_level)/COOLING NOZZLE$", "phase": "HEATING_NOZZLE", "message": "Cooling for probing...", "weight": 15 },
    { "pattern": "^print/RESUMING HEAT$", "phase": "HEATING_NOZZLE", "message": "Reheating...", "weight": 15 },
    { "pattern": "^print/PARKING$", "phase": "HEATING_NOZZLE", "message": "Preparing...", "weight": 15 },
    { "pattern": "^[a-z_]+/HEATING NOZZLE$", "phase": "HEATING_NOZZLE", "message": "Heating Nozzle...", "weight": 15 },
    { "pattern": "^[a-z_]+/HEATING BED$", "phase": "HEATING_BED", "message": "Heating Bed...", "weight": 15 },
    { "pattern": "^(nozzle_clean|kamp|bed_level)/HEATING$", "phase": "HEATING_BED", "message": "Heating...", "weight": 15 }
  ]
}
