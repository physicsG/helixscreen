#
# crosstool-NG defconfig for the unified HelixScreen MIPS binary (K1 series + AD5X)
#
# Target: mipsel-k1-linux-musl
# CPU:    MIPS32r2, little-endian, o32 ABI, hardware FP with NaN2008 + FP64
# Use:    Building a static cross-toolchain inside Docker for HelixScreen
#
# Same skeleton as k1-ct-ng.config (ct-ng 1.26, GCC 7.5, binutils 2.31,
# -mnan=2008 -mfp64) with glibc swapped for musl 1.2.4. glibc cannot serve
# both boards: on mips o32 + nan2008 its configure fragment pins
# arch_minimum_kernel=4.5.0 (sysdeps/unix/sysv/linux/mips/configure.ac), and
# --enable-kernel below that is silently reset, so every -static binary
# aborts on the K1's 4.4.94 kernel with "FATAL: kernel too old" (verified by
# disassembling the check: the compiled constant is 0x40500). musl has no
# kernel floor at all and the shipping K1 screen binary already runs musl
# 1.2.5 on 4.4.94; 1.2.4 is the closest ct-ng 1.26 offers.
#
# To use:
#   cp mips-ct-ng.config .config
#   ct-ng olddefconfig
#   ct-ng build
#

CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y

#
# Toolchain install prefix (not read-only so ct-ng can write during build)
#
CT_PREFIX_DIR="/opt/k1-toolchain"
# CT_PREFIX_DIR_RO is not set

#
# Target architecture: MIPS32r2, little-endian, hardware float
#
CT_ARCH_MIPS=y
CT_ARCH_LE=y
CT_ARCH_ARCH="mips32r2"
CT_ARCH_FLOAT_HW=y

#
# NaN2008 + FP64 flags. The AD5X kernel accepts only nan2008 binaries
# (a legacy-NaN ELF gets ENOEXEC there), so the whole toolchain — libc
# included — is built nan2008. FP64 on the K1's 4.4.94 kernel is proven:
# an o32 FP64 static probe computes correct double math there.
#
CT_TARGET_CFLAGS="-mnan=2008 -mfp64"

#
# Deliberately NOT a static toolchain: a static build silently disables LTO,
# which the release build's -flto=auto relies on.
#

#
# Target tuple vendor string: mipsel-k1-linux-musl
#
CT_TARGET_VENDOR="k1"

#
# Linux kernel headers: 4.16 or newer is required. musl 1.2 has a 64-bit
# time_t on 32-bit MIPS, and only 4.16+ uapi headers honour its
# __USE_TIME_BITS64, keeping struct input_event at the 16 bytes a 32-bit
# kernel writes. Older headers give 24 and every touch event decodes as
# EV_SYN. Headers impose no runtime floor, so the K1's 4.4 kernel is fine.
#
CT_KERNEL_LINUX=y
CT_LINUX_V_4_19=y

#
# binutils 2.40 — the version the GCC 13 build is proven against
#
CT_BINUTILS_V_2_40=y

#
# musl 1.2.4 — same line as the shipping K1 toolchain's 1.2.5
#
CT_LIBC_MUSL=y
CT_MUSL_V_1_2_4=y

#
# GCC 13.2.0. The produced binary is fully static, so there is no device
# libstdc++ whose ABI constrains the compiler version.
#
CT_GCC_V_13=y
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--with-nan=2008 --with-fp-32=64"
CT_CC_LANG_CXX=y

#
# Disable debug facilities (saves significant build time)
#
# CT_DEBUG_DUMA is not set
# CT_DEBUG_STRACE is not set
