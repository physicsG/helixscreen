<!-- Barcode Scanner settings overlay. Persistent configuration for scanner -->
<!-- input-device selection and keyboard layout. Replaces ScannerPickerModal.-->
<component>
  <view name="barcode_scanner_settings" extends="overlay_panel" title="Barcode Scanner" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">

      <!-- Current Selection -->
      <setting_group name="group_current_selection">
        <setting_group_header title="CURRENT SELECTION"/>
        <lv_obj width="100%"
                height="content" flex_flow="row" style_flex_cross_place="center" style_pad_left="#space_lg"
                style_pad_right="#space_lg" style_pad_top="#space_md" style_pad_bottom="#space_md"
                style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false">
          <text_body width="content" text="Selected"/>
          <text_muted name="current_device_label"
                      bind_text="scanner_current_device_label" flex_grow="1" style_text_align="right"/>
        </lv_obj>
      </setting_group>

      <!-- Keyboard Layout -->
      <setting_group name="group_keyboard_layout">
        <setting_group_header title="KEYBOARD LAYOUT"/>
        <lv_obj width="100%"
                height="content" flex_flow="row" style_flex_cross_place="center" style_pad_left="#space_lg"
                style_pad_right="#space_lg" style_pad_top="#space_sm" style_pad_bottom="#space_sm"
                style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false">
          <text_body text="Layout" flex_grow="1"/>
          <lv_dropdown name="keymap_dropdown"
                       width="45%" height="content" options="US QWERTY&#10;German QWERTZ&#10;French AZERTY"
                       bind_value="scanner_keymap_index" style_radius="#border_radius">
            <event_cb trigger="value_changed" callback="on_bs_keymap_changed"/>
          </lv_dropdown>
        </lv_obj>
      </setting_group>

      <!-- USB Devices -->
      <setting_group name="group_usb_devices">
        <setting_group_header title="USB DEVICES"/>
        <lv_obj name="usb_device_list"
                width="100%" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="0" style_bg_opa="0"
                style_border_width="0" scrollable="false"/>
        <lv_obj width="100%"
                height="content" flex_flow="row" style_flex_main_place="center" style_pad_all="#space_md"
                style_bg_opa="0" style_border_width="0" scrollable="false">
          <ui_button name="btn_refresh_usb" width="200" text="Refresh" icon="refresh">
            <event_cb trigger="clicked" callback="on_bs_refresh_usb"/>
          </ui_button>
        </lv_obj>
      </setting_group>

      <!-- Bluetooth (hidden when BT unavailable) -->
      <lv_obj name="section_bluetooth"
              width="100%" height="content" flex_flow="column" style_bg_opa="0" style_border_width="0" style_pad_all="0"
              scrollable="false">
        <bind_flag_if_eq subject="scanner_bt_available" flag="hidden" ref_value="0"/>
        <setting_group name="group_bluetooth_scanners">
          <setting_group_header title="BLUETOOTH SCANNERS"/>
          <setting_dropdown_row name="row_bt_scanners"
                                label="Scanner" icon="magnify" dropdown_width="66%" hide_description="true"
                                callback="on_bs_bt_scanner_selected"/>
          <lv_obj name="row_bt_actions"
                  width="100%" height="content" flex_flow="row" style_flex_main_place="center"
                  style_flex_cross_place="center" style_pad_all="#space_md" style_pad_gap="#space_md" style_bg_opa="0"
                  style_border_width="0" scrollable="false">
            <spinner name="bt_scan_spinner" size="sm" hidden="true">
              <bind_flag_if_eq subject="scanner_bt_discovering" flag="hidden" ref_value="0"/>
            </spinner>
            <ui_button name="btn_bt_scan" width="#button_width_action" text="Scan" icon="magnify_scan">
              <event_cb trigger="clicked" callback="on_bs_scan_bluetooth"/>
            </ui_button>
            <ui_button name="btn_bt_pair" width="#button_width_action" text="Pair" icon="bluetooth" disabled="true">
              <event_cb trigger="clicked" callback="on_bs_bt_pair"/>
            </ui_button>
            <ui_button name="btn_bt_forget" width="#button_width_action" text="Forget" icon="delete" disabled="true">
              <event_cb trigger="clicked" callback="on_bs_bt_forget"/>
            </ui_button>
          </lv_obj>
        </setting_group>
      </lv_obj>

    </lv_obj>
  </view>
</component>
