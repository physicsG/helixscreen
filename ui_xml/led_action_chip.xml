<!-- A pill chip on the LEDs overlay (a level, the None effect, a macro action).
     Lit while active_subject equals active_value; an empty active_subject never lights. -->
<!-- Extends ui_button, which keeps the label readable on either fill. -->
<component>
  <api>
    <prop name="label" type="string" default="Action"/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="active_subject" type="string" default=""/>
    <prop name="active_value" type="string" default="0"/>
  </api>
  <view extends="ui_button"
        height="#led_chip_height" variant="ghost" text="$label" translation_tag="$label_tag"
        style_radius="#led_chip_height" style_min_width="#led_chip_min_width" style_pad_left="#space_md"
        style_pad_right="#space_md" ext_click_area="#led_chip_gap_half">
    <!-- Idle first, active after: the later style wins while it is enabled. -->
    <style name="styles.led_chip_idle"/>
    <bind_style_if_eq name="styles.led_chip_active" subject="$active_subject" ref_value="$active_value"/>
  </view>
</component>
