<component>
  <api>
    <prop name="severity" type="string"/>
    <!-- "error", "warning", "info", "success" -->
    <prop name="title" type="string"/>
    <prop name="message" type="string"/>
    <prop name="timestamp" type="string"/>
  </api>
  <!-- Compact notification card with left color border (severity_card handles colors) -->
  <view name="notification_item"
        extends="severity_card" width="100%" height="content" severity="$severity" style_pad_left="#space_md"
        style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_bg_color="#card_bg"
        style_bg_opa="255" style_border_width="4" style_border_side="left" style_radius="#border_radius"
        scrollable="false" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="start">
    <!-- Icon column (fixed width for icon) -->
    <lv_obj width="28" style_pad_all="0" style_pad_top="#space_xxs" clickable="false" event_bubble="true">
      <!-- Severity icons - all hidden by default, finalize() shows the correct one -->
      <lv_label name="icon_info"
                text="#icon_info_circle" hidden="true" style_text_font="mdi_icons_24" style_text_color="#info"/>
      <lv_label name="icon_success"
                text="#icon_check" hidden="true" style_text_font="mdi_icons_24" style_text_color="#success"/>
      <lv_label name="icon_warning"
                text="#icon_triangle_exclamation" hidden="true" style_text_font="mdi_icons_24"
                style_text_color="#warning"/>
      <lv_label name="icon_error"
                text="#icon_alert_octagon" hidden="true" style_text_font="mdi_icons_24" style_text_color="#danger"/>
    </lv_obj>
    <!-- Content column (flex grow) -->
    <lv_obj flex_grow="1"
            style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" clickable="false" event_bubble="true">
      <!-- Headline row: the title, or the message itself for an untitled entry -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="row"
              style_flex_cross_place="start" clickable="false" event_bubble="true">
        <text_body name="item_title" flex_grow="1" text="$title" long_mode="wrap"/>
        <text_small name="item_timestamp" text="$timestamp"/>
      </lv_obj>
      <!-- Message (hidden when it was promoted to the headline) -->
      <text_small name="item_message" width="100%" text="$message" long_mode="wrap" hidden_if_empty="$message"/>
    </lv_obj>
  </view>
</component>
