<!-- Shown while a browser drives this screen through the built-in screen server, so
     the person at the printer can see someone else is. Lives on the top layer so no
     panel or overlay covers it. The transparent outer box carries the inset from the
     corner. -->
<component>
  <view extends="lv_obj"
        width="content" height="content" align="top_right" style_pad_top="#space_sm" style_pad_right="#space_sm"
        style_pad_left="0" style_pad_bottom="0" style_bg_opa="0" style_border_width="0" clickable="false"
        scrollable="false" hidden="true">
    <bind_flag_if_eq subject="remote_screen_control_active" flag="hidden" ref_value="0"/>
    <lv_obj width="content"
            height="content" style_radius="#border_radius" style_bg_color="#card_bg" style_bg_opa="90%"
            style_pad_all="#space_xs" style_border_width="0" clickable="false" scrollable="false">
      <icon src="remote_desktop" size="sm" variant="primary" clickable="false"/>
    </lv_obj>
  </view>
</component>
