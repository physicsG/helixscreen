<!-- Full-screen busy card shown on the top layer while the app switches printers.
     The backdrop is clickable so taps never reach the screen being rebuilt under it.
     PrinterSwitchFlow creates one per phase; title and phase arrive translated, and
     animated is "false" on render tiers that cannot afford a moving spinner. -->
<component>
  <api>
    <prop name="title" type="string" default=""/>
    <prop name="phase" type="string" default=""/>
    <prop name="animated" type="string" default="true"/>
  </api>
  <view extends="lv_obj"
        width="100%" height="100%" style_bg_opa="128" style_bg_color="0x000000" style_border_width="0" style_pad_all="0"
        style_radius="0" clickable="true" scrollable="false">
    <lv_obj width="60%"
            height="content" align="center" style_bg_color="#elevated_bg" style_bg_opa="255"
            style_radius="#border_radius" style_pad_all="#space_lg" style_pad_gap="#space_md" flex_flow="column"
            style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
            scrollable="false" clickable="false" event_bubble="true">
      <spinner name="switch_interstitial_spinner" size="lg" animated="$animated"/>
      <text_heading name="switch_interstitial_title" width="100%" text="$title" style_text_align="center"/>
      <text_muted name="switch_interstitial_phase" width="100%" text="$phase" style_text_align="center"/>
    </lv_obj>
  </view>
</component>
