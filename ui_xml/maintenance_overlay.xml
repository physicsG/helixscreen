<!-- Maintenance overlay, opened from the maintenance home tile. A card per meter (hidden
     while its interval is Off) with a ring of the interval used, the hours left inside
     it, the used hours and the last reset, and a Reset that asks first; the total print
     time; then the service interval per meter. Everything binds maintenance_model's
     subjects (src/ui/panel_widgets/maintenance_model.h). The interval dropdowns' options
     come from kIntervalChoices (MaintenanceOverlay::apply_interval_options). -->
<component>
  <styles>
    <style name="mt_font_small" text_font="#font_small"/>
  </styles>
  <view name="maintenance_overlay" extends="overlay_panel" title="Maintenance" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_lg" style_pad_row="#space_md" scrollable="true" flex_flow="column">
      <lv_obj name="mt_cards"
              width="100%" height="content" style_pad_hor="#space_lg" style_pad_ver="0" style_pad_row="#space_sm"
              flex_flow="column" scrollable="false" style_bg_opa="0" style_border_width="0">
        <repeat count="3">
          <ui_card name="mt_card_${i}"
                   width="100%" height="content" flex_flow="row" style_pad_all="#space_sm" style_pad_column="#space_md"
                   style_flex_cross_place="center" scrollable="false">
            <bind_flag_if_eq subject="maintenance_m${i}_on" flag="hidden" ref_value="0"/>
            <lv_obj name="mt_card_dial_${i}"
                    width="#button_height_lg" height="#button_height_lg" style_pad_all="0" style_bg_opa="0"
                    style_border_width="0" scrollable="false">
              <helix_progress_arc name="mt_card_ring_${i}"
                                  width="100%" height="100%" align="center" bind_value="maintenance_m${i}_pct"
                                  bg_start_angle="270" bg_end_angle="269" start_angle="270" end_angle="270"
                                  style_arc_width="#space_xs" style_arc_width-indicator="#space_xs">
                <bind_style_if_eq name="styles.maint_arc_warn"
                                  subject="maintenance_m${i}_status" ref_value="1" selector="indicator"/>
                <bind_style_if_eq name="styles.maint_arc_danger"
                                  subject="maintenance_m${i}_status" ref_value="2" selector="indicator"/>
              </helix_progress_arc>
              <text_tiny name="mt_card_left_${i}" align="center" bind_text="maintenance_m${i}_left">
                <bind_style_if_ge name="mt_font_small" subject="ui_breakpoint" ref_value="2"/>
                <bind_style_if_eq name="styles.maint_text_warn" subject="maintenance_m${i}_status" ref_value="1"/>
                <bind_style_if_eq name="styles.maint_text_danger" subject="maintenance_m${i}_status" ref_value="2"/>
              </text_tiny>
            </lv_obj>
            <lv_obj width="0"
                    height="content" flex_grow="1" flex_flow="column" style_pad_all="0" style_pad_row="#space_xxs"
                    style_bg_opa="0" style_border_width="0" scrollable="false">
              <text_body name="mt_card_name_${i}" width="100%" bind_text="maintenance_m${i}_name" long_mode="wrap"/>
              <text_small name="mt_card_line_${i}"
                          width="100%" bind_text="maintenance_m${i}_line" style_text_color="#text_muted"
                          long_mode="wrap"/>
              <text_small name="mt_card_note_${i}"
                          width="100%" bind_text="maintenance_m${i}_note" style_text_color="#text_muted"
                          long_mode="wrap"/>
            </lv_obj>
            <ui_button name="mt_card_reset_${i}"
                       width="content" height="#button_height_sm" variant="outline" text="Reset" icon="refresh">
              <event_cb trigger="clicked" callback="maintenance_reset_cb" user_data="$i"/>
            </ui_button>
          </ui_card>
        </repeat>
        <text_small name="mt_total" width="100%" bind_text="maintenance_total_text" style_text_color="#text_muted"/>
      </lv_obj>
      <setting_group name="group_intervals">
        <setting_dropdown_row name="row_interval_0"
                              label="HEPA filter interval" icon="fan"
                              description="Print hours between filter changes. Off hides this meter."
                              bind_selected="maintenance_m0_interval" callback="maintenance_interval_0_cb"/>
        <setting_dropdown_row name="row_interval_1"
                              label="Nozzle interval" icon="nozzle"
                              description="Print hours between nozzle changes. Off hides this meter."
                              bind_selected="maintenance_m1_interval" callback="maintenance_interval_1_cb"/>
        <setting_dropdown_row name="row_interval_2"
                              label="Linear rails interval" icon="axis_arrow"
                              description="Print hours between rail cleaning and lubrication. Off hides this meter."
                              bind_selected="maintenance_m2_interval" callback="maintenance_interval_2_cb"/>
      </setting_group>
    </lv_obj>
  </view>
</component>
