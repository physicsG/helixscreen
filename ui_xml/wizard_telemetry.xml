<component>
  <!-- First-Run Wizard: Telemetry Opt-In Screen (preset mode only) -->
  <consts>
    <str name="step_title" value="Help Improve HelixScreen" value_tag="Help Improve HelixScreen"/>
    <str name="step_subtitle" value="Anonymous usage statistics" value_tag="Anonymous usage statistics"/>
  </consts>

  <view name="wizard_telemetry_root"
        extends="lv_obj" width="100%" height="100%" style_bg_opa="0" style_border_width="0" style_pad_all="0"
        flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center">

    <ui_card width="100%"
             flex_grow="1" style_pad_all="#space_lg" style_pad_gap="#space_md" flex_flow="column"
             style_flex_main_place="center" style_flex_cross_place="center" scrollable="false">

      <icon src="chart_line" size="lg" variant="primary"/>

      <text_heading width="100%" text="Help Improve HelixScreen" style_text_align="center"/>

      <text_body width="100%"
                 text="Share anonymous usage statistics to help us make HelixScreen better. No personal data is ever collected."
                 style_text_align="center"/>

      <lv_obj width="100%"
              height="content" style_pad_all="#space_sm" style_pad_gap="#space_md" flex_flow="row"
              style_flex_main_place="center" style_flex_cross_place="center" scrollable="false" style_bg_opa="0"
              style_border_width="0">
        <text_body text="Enable anonymous statistics"/>
        <ui_switch name="wizard_telemetry_toggle" size="tiny">
          <bind_state_if_eq subject="settings_telemetry_enabled" state="checked" ref_value="1"/>
          <event_cb trigger="value_changed" callback="on_wizard_telemetry_changed"/>
        </ui_switch>
      </lv_obj>

      <ui_button name="btn_telemetry_info" width="content" height="content" variant="ghost">
        <text_small text="Learn More"
                    style_text_color="#primary" style_text_decor="underline" clickable="false" event_bubble="true"/>
        <event_cb trigger="clicked" callback="on_wizard_telemetry_info"/>
      </ui_button>

    </ui_card>
  </view>
</component>
