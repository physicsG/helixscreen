<!-- One white tone on the LEDs overlay: a preview disc in a ring holder over its
     caption, ringed while led_page_white_sel equals tone; a tap sends
     led_white_cb(tone). -->
<component>
  <api>
    <prop name="tone" type="string" default="0"/>
    <prop name="label" type="string" default=""/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="color" type="string" default="#led_white_neutral"/>
  </api>
  <styles>
    <style name="disc_plain" border_width="0"/>
  </styles>
  <view extends="lv_obj"
        width="content" height="content" flex_flow="column" style_flex_cross_place="center" style_pad_all="0"
        style_pad_gap="0" style_bg_opa="0" style_border_width="0" clickable="true" scrollable="false"
        ext_click_area="#led_swatch_gap_half">
    <lv_obj name="tone_swatch"
            width="#led_swatch_size" height="#led_swatch_size" clickable="false" event_bubble="true" scrollable="false">
      <style name="styles.led_ring_holder"/>
      <bind_style_if_eq name="styles.led_swatch_ring" subject="led_page_white_sel" ref_value="$tone"/>
      <lv_obj name="disc"
              width="100%" height="100%" style_radius="9999" style_bg_opa="255" style_bg_color="$color"
              clickable="false" event_bubble="true" scrollable="false">
        <!-- No inline border: it would outrank the light-theme edge bound after it. -->
        <style name="disc_plain"/>
        <bind_style_if name="styles.contrast_edge" cond="settings_dark_mode eq 0"/>
      </lv_obj>
    </lv_obj>
    <text_small name="tone_caption"
                text="$label" translation_tag="$label_tag" style_text_color="#text_muted" clickable="false"
                event_bubble="true"/>
    <event_cb trigger="clicked" callback="led_white_cb" user_data="$tone"/>
  </view>
</component>
