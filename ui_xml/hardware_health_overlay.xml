<!-- Hardware Health Overlay - Shows detailed hardware validation results -->
<!-- Displays issues grouped by severity: Critical, Warning, Info -->
<component>
  <view name="hardware_health_overlay" extends="overlay_panel" title="Hardware Health" bg_color="#screen_bg">
    <!-- Content Area -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="#space_lg" style_pad_bottom="#space_lg" style_pad_left="0"
            style_pad_right="0" scrollable="true" flex_flow="column" style_pad_gap="#space_md">
      <!-- ================================================================== -->
      <!-- STATUS CARD - Shows overall health status -->
      <!-- ================================================================== -->
      <ui_card name="status_card"
               width="100%" height="content" style_border_width="0" style_pad_all="#space_lg" scrollable="false"
               style_margin_left="#space_sm" style_margin_right="#space_sm" flex_flow="row"
               style_flex_cross_place="center" style_pad_gap="#space_md">
        <!-- One badge per hardware_status_level value; exactly one is visible -->
        <lv_obj name="status_icon_container"
                width="#icon_badge_size" height="#icon_badge_size" style_bg_color="#success" style_bg_opa="255"
                style_radius="#icon_badge_radius" scrollable="false" style_pad_all="0" flex_flow="column"
                style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
          <bind_flag_if_not_eq subject="hardware_status_level" flag="hidden" ref_value="0"/>
          <icon name="status_icon_ok" src="check" size="md" variant="text"/>
        </lv_obj>
        <lv_obj name="status_icon_container_warn"
                width="#icon_badge_size" height="#icon_badge_size" style_bg_color="#warning" style_bg_opa="255"
                style_radius="#icon_badge_radius" scrollable="false" style_pad_all="0" flex_flow="column"
                style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
          <bind_flag_if_not_eq subject="hardware_status_level" flag="hidden" ref_value="1"/>
          <icon name="status_icon_warn" src="alert" size="md" variant="text"/>
        </lv_obj>
        <lv_obj name="status_icon_container_crit"
                width="#icon_badge_size" height="#icon_badge_size" style_bg_color="#danger" style_bg_opa="255"
                style_radius="#icon_badge_radius" scrollable="false" style_pad_all="0" flex_flow="column"
                style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
          <bind_flag_if_not_eq subject="hardware_status_level" flag="hidden" ref_value="2"/>
          <icon name="status_icon_crit" src="alert_octagon" size="md" variant="text"/>
        </lv_obj>
        <!-- Status text -->
        <lv_obj height="content" style_pad_all="0" scrollable="false" flex_flow="column" style_pad_gap="#space_xs">
          <text_heading name="status_title" bind_text="hardware_status_title"/>
          <text_small name="status_detail" bind_text="hardware_status_detail"/>
        </lv_obj>
      </ui_card>
      <!-- ================================================================== -->
      <!-- CRITICAL ISSUES SECTION (red) - Missing required hardware -->
      <!-- ================================================================== -->
      <setting_group name="critical_section">
        <bind_flag_if_eq subject="hardware_critical_count" flag="hidden" ref_value="0"/>
        <setting_group_header title="CRITICAL" icon="alert_octagon" hide_icon="false"/>
        <lv_obj name="critical_issues_list"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="#space_xs">
          <!-- hardware_issue_row components added dynamically by C++ -->
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- WARNING ISSUES SECTION (orange) - Missing configured hardware -->
      <!-- ================================================================== -->
      <setting_group name="warning_section">
        <bind_flag_if_eq subject="hardware_warning_count" flag="hidden" ref_value="0"/>
        <setting_group_header title="MISSING CONFIGURED" icon="alert" hide_icon="false"/>
        <lv_obj name="warning_issues_list"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="#space_xs">
          <!-- hardware_issue_row components added dynamically by C++ -->
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- INFO ISSUES SECTION (blue) - Newly discovered hardware -->
      <!-- ================================================================== -->
      <setting_group name="info_section">
        <bind_flag_if_eq subject="hardware_info_count" flag="hidden" ref_value="0"/>
        <setting_group_header title="NEWLY DISCOVERED" icon="info" hide_icon="false"/>
        <lv_obj name="info_issues_list"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="#space_xs">
          <!-- hardware_issue_row components added dynamically by C++ -->
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- SESSION CHANGES SECTION - Hardware changed since last session -->
      <!-- ================================================================== -->
      <setting_group name="session_section">
        <bind_flag_if_eq subject="hardware_session_count" flag="hidden" ref_value="0"/>
        <setting_group_header title="CHANGED FROM LAST SESSION" icon="refresh" hide_icon="false"/>
        <lv_obj name="session_issues_list"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="#space_xs">
          <!-- hardware_issue_row components added dynamically by C++ -->
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- INFO NOTE -->
      <!-- ================================================================== -->
      <lv_obj width="100%"
              height="content" scrollable="false" style_pad_left="0" style_pad_right="0" style_pad_top="#space_md"
              style_pad_bottom="#space_lg" flex_flow="row" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_sm">
        <icon src="info" size="xs" variant="secondary"/>
        <text_small text="Hardware is validated on startup and reconnection"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
