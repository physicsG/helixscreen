<!-- Batch filament picker - tick rows, then run them as one operation in the
     direction the picker was opened in (Load or Unload). The title and the
     primary caption come from the batch_filament_*_text subjects, which
     BatchFilamentModal::show_owned(for_load) publishes per open. -->
<!-- Rows are populated by BatchFilamentModal; backdrop created by Modal system -->
<component>
  <view name="batch_filament_modal"
        extends="ui_dialog" width="70%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <!-- Content area -->
    <lv_obj width="100%"
            height="content" style_pad_all="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_md">
      <text_heading name="batch_title" width="100%" bind_text="batch_filament_title_text" style_text_align="center"/>
      <ui_multiselect name="batch_multiselect"/>
    </lv_obj>
    <!-- The shared footer row. The primary caption names the opening
         direction, so it arrives by subject; running it feeds or unloads
         filament, so it carries the toolhead guard. Callbacks are wired
         programmatically per-instance (a real Cancel), not via XML. -->
    <modal_button_row secondary_variant="secondary"
                      secondary_text="Cancel" primary_subject="batch_filament_action_text" primary_moves_machine="true"/>
  </view>
</component>
