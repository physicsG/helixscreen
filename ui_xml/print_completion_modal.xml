<component>
  <!-- Print Completion Modal -->
  <!-- Note: Backdrop is created programmatically by Modal class in C++ -->
  <view name="print_completion_modal"
        extends="ui_dialog" width="75%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <!-- Content area -->
    <lv_obj width="100%"
            height="content" style_min_height="140" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_md">
      <!-- Status icon (src/variant set imperatively - no XML binding for icon properties) -->
      <icon name="status_icon" src="check_circle" size="lg" variant="success"/>
      <!-- Title bound to completion state subject -->
      <text_heading name="title_label" width="100%" bind_text="print_completion_title" style_text_align="center"/>
      <!-- Filename bound to subject -->
      <text_body name="filename_label"
                 width="100%" bind_text="print_completion_filename" long_mode="dots" style_text_align="center"
                 style_text_color="#text"/>
      <!-- Stats grid container -->
      <lv_obj name="stats_grid"
              width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
              style_pad_gap="#space_lg">
        <!-- Duration stat -->
        <lv_obj height="content"
                style_pad_all="0" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_xs">
          <icon src="clock" size="md" variant="muted"/>
          <text_small name="duration_label" bind_text="print_completion_duration"/>
        </lv_obj>
        <!-- Slicer estimate stat (hidden when no estimate available) -->
        <lv_obj name="estimate_stat"
                width="content" height="content" style_pad_all="0" flex_flow="column" style_flex_cross_place="center"
                style_pad_gap="#space_xs">
          <bind_flag_if_eq subject="print_completion_has_estimate" flag="hidden" ref_value="0"/>
          <icon src="progress_clock" size="md" variant="muted"/>
          <text_small name="estimate_label" bind_text="print_completion_estimate"/>
        </lv_obj>
        <!-- Layers stat -->
        <lv_obj height="content"
                style_pad_all="0" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_xs">
          <icon src="layers" size="md" variant="muted"/>
          <text_small name="layers_label" bind_text="print_completion_layers"/>
        </lv_obj>
        <!-- Filament stat (hidden when no filament data available) -->
        <lv_obj name="filament_stat"
                width="content" height="content" style_pad_all="0" flex_flow="column" style_flex_cross_place="center"
                style_pad_gap="#space_xs">
          <bind_flag_if_eq subject="print_completion_has_filament" flag="hidden" ref_value="0"/>
          <icon src="filament" size="md" variant="muted"/>
          <text_small name="filament_label" bind_text="print_completion_filament"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>
    <!-- Button row: OK always; "Start next: <name>" only while the queue has
         jobs — job_queue_count drives the secondary's visibility, the
         job_queue_start_next_text subject its label. -->
    <modal_button_row primary_text="OK"
                      secondary_variant="primary" primary_callback="on_print_complete_ok"
                      secondary_subject="job_queue_start_next_text" secondary_show_subject="job_queue_count"
                      secondary_callback="on_print_complete_start_next"/>
  </view>
</component>
