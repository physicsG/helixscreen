<!-- Bed Mesh Panel - Mainsail-inspired two-card layout -->
<!-- Left: 3D mesh visualization with touch drag rotation -->
<!-- Right: "Current Mesh" stats card + "Profiles" list card -->
<component>
  <!-- Component-local constants for mesh visualization colors and responsive sizing -->
  <consts>
    <!-- Mesh visualization gradient -->
    <color name="mesh_low" value="#88c0d0"/>
    <!-- nord8 - cold -->
    <color name="mesh_mid" value="#a3be8c"/>
    <!-- nord14 - neutral -->
    <color name="mesh_high" value="#bf616a"/>
    <!-- nord11 - hot -->

    <!-- Info column width per breakpoint. Landscape only — portrait has no
         side column (see the <if> in the view below), so this const is
         unused in that arrangement's branch. -->
    <px name="bed_mesh_info_column_width_tiny" value="180"/>
    <px name="bed_mesh_info_column_width_small" value="280"/>
    <px name="bed_mesh_info_column_width_medium" value="280"/>
    <px name="bed_mesh_info_column_width_large" value="280"/>

    <!-- current_mesh_card's width in portrait_cards_row (portrait only).
         NOT the same value as bed_mesh_info_column_width: in landscape that
         token sizes a column that current_mesh_card has ENTIRELY to itself
         (profiles_card sits below it, not beside it, so it also gets the
         full 280). In portrait the two cards split ONE row's width, so
         giving current_mesh_card landscape's 280 leaves profiles_card only
         ~170px at a 480px screen — not enough room for its range column,
         rename/load icon, delete icon, AND a readable profile name, and
         "adaptive"/"default" wrapped character-by-character
         (prestonbrown/helixscreen#1204-adjacent). These values were sized
         empirically against the profiles list's actual per-row chrome
         (range width 50, two icon columns, inter-item gaps) rather than
         reused from the landscape side column, which was never sized for a
         second card to share its width with. -->
    <px name="bed_mesh_portrait_info_width_tiny" value="130"/>
    <px name="bed_mesh_portrait_info_width_small" value="170"/>
    <px name="bed_mesh_portrait_info_width_medium" value="200"/>
    <px name="bed_mesh_portrait_info_width_large" value="205"/>

    <!-- Profile row height per breakpoint. Declared here (not in
         ui_xml/components/bed_mesh_profiles_card.xml, which is where it is
         actually used) because theme_manager_find_xml_files() only scans
         top-level ui_xml/*.xml for the "_micro"/"_tiny"/... auto-discovery
         that produces the responsive #bed_mesh_profile_row_height token
         (check_responsive_token_scope.py, prestonbrown/helixscreen#1211) — a
         components/ subdirectory declaration is invisible to it. Once
         declared here the token resolves globally, including from the
         profiles card component.

         This was a hardcoded 44 at all five row sites. At MICRO the info column
         is 212px, the current-mesh card takes 134 of it, and the profiles list
         is left with a 33px viewport — so a 44px row never showed in full and
         the list was a slit you could not read (prestonbrown/helixscreen#1204).
         44 is kept from SMALL up, where it is a comfortable touch target; the
         smaller tiers trade some target size for actually being able to see a
         row. Paired with hiding the Max/Min stat rows at MICRO and TINY (in
         bed_mesh_current_mesh_card.xml), which is what frees the vertical room
         for two rows instead of none. -->
    <px name="bed_mesh_profile_row_height_micro" value="28"/>
    <px name="bed_mesh_profile_row_height_tiny" value="32"/>
    <px name="bed_mesh_profile_row_height_small" value="44"/>
    <px name="bed_mesh_profile_row_height_medium" value="44"/>
    <px name="bed_mesh_profile_row_height_large" value="44"/>
  </consts>
  <view name="bed_mesh_panel"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_bg_opa="255"
        style_bg_color="#card_bg" style_pad_all="0" style_border_width="0" scrollable="false" flex_flow="column">
    <!-- Header Bar with CALIBRATE action button -->
    <header_bar name="overlay_header"
                title="Bed Mesh" action_button_text="Probe" action_button_height="#button_height"
                action_button_pad="#space_md" hide_action_button="false"
                action_button_callback="on_bed_mesh_calibrate_clicked"
                action_button_disabled_cond="nav_buttons_enabled eq 0"/>
    <!-- Content Area: landscape is a row (canvas left, cards in a fixed-width
         side column); portrait is a column — canvas on top, then mesh info
         and the profiles list SIDE BY SIDE in one row below it (not
         stacked). ui_is_portrait is reactive, so a rotation rebuilds this
         <if> in place — see docs/devel/LVGL9_XML_GUIDE.md "Structural
         conditionals with <if> / <else>".

         current_mesh_card and profiles_card are IDENTICAL in both
         arrangements (docs/devel/LVGL9_XML_GUIDE.md and this task's brief both
         call this out as the trap: pasting their ~150 lines into both
         branches would duplicate them in a way no gate can see, since they'd
         coexist in one file). They are therefore their own components
         (ui_xml/components/bed_mesh_current_mesh_card.xml,
         bed_mesh_profiles_card.xml) and each branch below just instantiates
         them — the markup itself exists exactly once. What genuinely differs
         between the two arrangements is structural (a fixed-width side
         column holding both cards stacked, vs. a full-width row below the
         canvas holding both cards side by side) rather than a simple
         attribute swap, which is why this needs <if> rather than a cheaper
         bind_style_if/cond= toggle. -->
    <if cond="ui_is_portrait eq 1">
      <lv_obj name="overlay_content"
              width="100%" flex_grow="1" style_pad_all="#space_md" scrollable="false" flex_flow="column"
              style_pad_gap="#space_md">
        <!-- Disable content when printer not connected or klippy not ready -->
        <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
        <!-- Top: 3D Mesh Canvas. 45% is the pre-measurement default;
             BedMeshPanel::apply_portrait_canvas_height() (wired on
             overlay_content's SIZE_CHANGED) refines it once the column has
             been laid out, reserving room for the info/profiles row below
             so it is never squeezed to nothing — see that function for the
             reservation math. If the measurement returns 0 (not laid out
             yet), this value stands on its own. -->
        <bed_mesh_canvas_band name="canvas_wrapper" width="100%" height="45%"/>
        <!-- Bottom: mesh info and the profiles list side by side in one
             row, sharing this row's height. The split favors profiles_card
             (flex_grow="1", takes the remainder) over current_mesh_card
             (fixed #bed_mesh_portrait_info_width — see that const's comment
             for why this is NOT landscape's info_column width): the
             profiles list has more per-row chrome fighting for space (a
             range column, two icon columns) than current_mesh_card's simple
             label/value rows, and its name field now truncates with
             long_mode="dots" (bed_mesh_profiles_card.xml) as a second line
             of defense rather than wrapping character-by-character.
             profiles_card fills the row's full height via height="100%"
             rather than shrinking to current_mesh_card's own content size. -->
        <lv_obj name="portrait_cards_row"
                width="100%" flex_grow="1" flex_flow="row" style_pad_all="0" style_pad_gap="#space_md"
                scrollable="false">
          <bed_mesh_current_mesh_card name="current_mesh_card" width="#bed_mesh_portrait_info_width"/>
          <bed_mesh_profiles_card name="profiles_card" height="100%" flex_grow="1"/>
        </lv_obj>
      </lv_obj>
      <else/>
      <lv_obj name="overlay_content"
              width="100%" flex_grow="1" style_pad_all="#space_md" scrollable="false" flex_flow="row"
              style_pad_gap="#space_md">
        <!-- Disable content when printer not connected or klippy not ready -->
        <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
        <!-- Left: 3D Mesh Canvas wrapper (fills remaining space) -->
        <bed_mesh_canvas_band name="canvas_wrapper" height="100%" flex_grow="1"/>
        <!-- Right: fixed-width side column holding the two cards -->
        <lv_obj name="info_column"
                width="#bed_mesh_info_column_width" height="100%" flex_flow="column" style_pad_all="0"
                style_pad_gap="#space_md" scrollable="false">
          <bed_mesh_current_mesh_card name="current_mesh_card"/>
          <bed_mesh_profiles_card name="profiles_card"/>
        </lv_obj>
      </lv_obj>
    </if>
  </view>
</component>
