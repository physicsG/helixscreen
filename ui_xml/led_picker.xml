<component>
  <!-- Full-screen backdrop overlay - tap to dismiss. Rows come from
       light_picker_devices() (src/ui/panel_widgets/led_widget.h); a row's
       user_data is its index, -1 for All lights. Rows read like the fan
       picker's: left-aligned names, the chosen one highlighted. -->
  <view name="led_picker" extends="context_menu_backdrop">
    <context_menu_card title="This button controls" pad_gap="#space_xs">
      <!-- max_height set by C++ to a share of the screen -->
      <lv_obj name="led_picker_list"
              width="100%" height="content" flex_flow="column" style_pad_all="#space_xs" style_pad_gap="0"
              scrollable="true">
        <repeat count="led_picker_count">
          <lv_obj name="led_picker_row_${i}"
                  width="100%" height="#button_height" flex_flow="row" style_flex_cross_place="center"
                  style_flex_track_place="center" clickable="true" scrollable="false">
            <style name="styles.press_wash" selector="pressed"/>
            <style name="styles.picker_row"/>
            <bind_style_if_eq name="styles.selected_row" subject="led_picker_selected" ref_value="${i}"/>
            <text_body name="led_picker_label_${i}"
                       bind_text="led_picker_name_${i}" flex_grow="1" long_mode="dots" clickable="false"
                       event_bubble="true"/>
            <event_cb trigger="clicked" callback="led_picker_row_cb" user_data="${i}"/>
          </lv_obj>
        </repeat>
      </lv_obj>
      <!-- Inset like the list above, so every name starts on one line. -->
      <lv_obj width="100%" height="content" style_pad_hor="#space_xs" style_pad_ver="0" scrollable="false">
        <lv_obj name="led_picker_all"
                width="100%" height="#button_height" flex_flow="row" style_flex_cross_place="center"
                style_flex_track_place="center" clickable="true" scrollable="false">
          <style name="styles.press_wash" selector="pressed"/>
          <style name="styles.picker_row"/>
          <bind_style_if_eq name="styles.selected_row" subject="led_picker_selected" ref_value="-1"/>
          <text_body text="All lights" flex_grow="1" long_mode="dots" clickable="false" event_bubble="true"/>
          <event_cb trigger="clicked" callback="led_picker_row_cb" user_data="-1"/>
        </lv_obj>
      </lv_obj>
    </context_menu_card>
  </view>
</component>
