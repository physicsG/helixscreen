<!-- The app's one color swatch (LEDs overlay rows, filament and theme preset grids).

     The swatch is its whole touch target: a transparent circle padded by the
     selection ring's reach, holding a round disc of its color. The ring is the
     holder's border, drawn inside the swatch, so no row or grid clips it. The
     holder carries the color as its (transparent) bg_color too, which is what a
     click handler reads back from the event target. Its hit area reaches `hit`
     past its edge, half the gap to its neighbour.

     Props:
       index             the swatch's position; the callback's user_data
       color_subject     color subject for the fill
       edge_subject      int subject, 1 where the fill blends into the current theme's surface
       selected_subject  int subject naming the ringed index; empty for no ring
       callback          click handler
       size, hit         touch size and hit reach tokens
       reach, ring       the ring's reach (the disc's inset) and its style; the
                         dense grids pass a thinner pair so their discs stay large -->
<component>
  <api>
    <prop name="index" type="string" default="0"/>
    <prop name="color_subject" type="string"/>
    <prop name="edge_subject" type="string"/>
    <prop name="selected_subject" type="string" default=""/>
    <prop name="callback" type="string"/>
    <prop name="size" type="string" default="#led_swatch_size"/>
    <prop name="hit" type="string" default="#led_swatch_gap_half"/>
    <prop name="reach" type="string" default="#led_ring_reach"/>
    <prop name="ring" type="string" default="styles.led_swatch_ring"/>
  </api>
  <styles>
    <style name="disc_plain" border_width="0"/>
  </styles>
  <view extends="lv_obj"
        width="$size" height="$size" clickable="true" scrollable="false" ext_click_area="$hit" style_pad_all="$reach">
    <style name="styles.led_ring_holder"/>
    <bind_style_prop prop="bg_color" subject="$color_subject"/>
    <bind_style_if_eq name="$ring" subject="$selected_subject" ref_value="$index"/>
    <lv_obj name="color_swatch_disc"
            width="100%" height="100%" style_radius="9999" style_bg_opa="255" clickable="false" event_bubble="true"
            scrollable="false">
      <!-- No inline border: it would outrank the light-theme edge bound after it. -->
      <style name="disc_plain"/>
      <bind_style_prop prop="bg_color" subject="$color_subject"/>
      <bind_style_if_eq name="styles.contrast_edge" subject="$edge_subject" ref_value="1"/>
    </lv_obj>
    <event_cb trigger="clicked" callback="$callback" user_data="$index"/>
  </view>
</component>
