<!-- Theme-editor preset palette (row_wrap, 6 columns x 5 rows).

     Structured for the 16 role tokens the theme editor edits, not for filament
     colors — see components/color_swatch_grid.xml for the general-purpose grid.

       rows 1-2  12-step surface ramp, dark -> light, alternating cool/warm/
                 neutral tint. Covers screen_bg / overlay_bg / card_bg /
                 elevated_bg / border / text_subtle / text_muted / text.
       rows 3-5  6 hue families x 3 tones. COLUMN IS THE HUE FAMILY
                 (red, amber, green, teal, blue, violet); row is the tone
                 (muted for dark mode, mid, deep for light mode).

     The values live in swatch_palette(ColorPicker::Palette::Theme) and are drawn
     from the tones the 17 shipped themes actually occupy, so a preset click
     lands near a real theme value rather than a Material 500.
     tests/unit/test_theme_swatch_grid.cpp pins the ordering — the ramp must
     stay monotonic and each accent column must stay in its hue family. -->
<component>
  <api>
    <!-- Required: each host names its own click handler. Same contract as
         color_swatch_grid — no default, so a screen cannot silently bind its
         swatches to another screen's handler. -->
    <prop name="swatch_callback" type="string"/>
    <!-- Int subject naming the ringed swatch; empty for a grid with no selection. -->
    <prop name="selected_subject" type="string" default=""/>
    <!-- Sizing tokens: a host with room of its own (the tabbed picker) passes larger
         ones; the columns follow from the grid's width. -->
    <prop name="swatch_size" type="string" default="#swatch_grid_size"/>
    <prop name="gap" type="string" default="#swatch_grid_gap"/>
    <prop name="gap_half" type="string" default="#swatch_grid_gap_half"/>
  </api>
  <view name="theme_swatch_grid"
        extends="lv_obj" width="#swatch_grid_width" height="content" style_pad_all="0" flex_flow="row_wrap"
        style_pad_gap="$gap" style_flex_main_place="center" scrollable="false">
    <!-- Colors come from ColorPicker's theme palette table (swatch_palette()),
         published as theme_swatch_color_<i>; the fixed count matches it. -->
    <repeat count="30">
      <color_swatch index="${i}"
                    color_subject="theme_swatch_color_${i}" edge_subject="theme_swatch_edge_${i}"
                    selected_subject="$selected_subject" callback="$swatch_callback" size="$swatch_size" hit="$gap_half"
                    reach="#swatch_grid_ring_reach" ring="styles.grid_swatch_ring"/>
    </repeat>
  </view>
</component>
