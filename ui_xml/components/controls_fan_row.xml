<!-- One secondary fan on the Controls cooling card: name, speed, and an icon saying -->
<!-- whether the fan is user-controllable (chevron) or automatic (A). -->
<!-- Created by ControlsPanel::populate_secondary_fans(); the card's list is the tap target. -->
<component>
  <api>
    <prop name="fan_name" type="string" default=""/>
    <prop name="fan_speed" type="string" default=""/>
    <prop name="indicator_icon" type="string" default="alpha_a_circle"/>
  </api>
  <view name="controls_fan_row"
        extends="lv_obj" width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0"
        style_pad_row="0" scrollable="false" clickable="false" flex_flow="row" style_flex_main_place="space_between"
        style_flex_cross_place="center" style_flex_track_place="center">
    <text_small name="fan_name_label"
                width="60%" text="$fan_name" long_mode="dots" style_text_color="#text_muted" clickable="false"/>
    <text_small name="fan_speed_label" text="$fan_speed" style_text_color="#text" clickable="false"/>
    <icon name="fan_indicator" src="$indicator_icon" size="xs" variant="secondary" clickable="false"/>
  </view>
</component>
