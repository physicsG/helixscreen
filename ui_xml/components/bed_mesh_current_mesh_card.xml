<component>
  <subjects>
    <!-- Hide the Max/Min stat rows when EITHER:
           - the cramped-axis tier is MICRO (ui_breakpoint eq 0) — the
             original #1204 rule, still needed for a narrow screen in ANY
             orientation (e.g. a narrow portrait phone, or a short landscape
             strip where the narrow axis is height), or
           - the screen is portrait AND vertically short (ui_breakpoint_v lt 5,
             i.e. LARGE or below on the vertical-resolution ladder).
         The second clause is gated on ui_is_portrait specifically because
         ui_breakpoint_v is keyed on raw vertical resolution regardless of
         orientation: 1024x600 landscape and a 480x640 portrait column both
         land on LARGE (breakpoint_for(600) and breakpoint_for(640) are both
         551-700). Without the ui_is_portrait guard this would also hide
         Max/Min on 1024x600 landscape, which has never been cramped — its
         info column is a fixed 280px wide with plenty of headroom; only the
         portrait STACK is short on space at that height.

         The first clause is deliberately eq 0 (MICRO only), NOT lt 2
         (MICRO+TINY): the portrait cramping this task addresses is carried
         entirely by the second clause, and widening the orientation-
         independent clause to TINY would also hide Max/Min on a 480x320
         LANDSCAPE panel (273-390 narrow-axis), which was never asked for and
         was never cramped by this task's changes — its landscape info
         column has the same headroom question as the 1024x600 case above.
         This is a subject_expr (declarative rule 7) rather than a
         hand-rolled C++ observer because the condition is reused at both the
         Max and the Min row below. -->
    <subject_expr name="bed_mesh_hide_stat_rows"
                  expr="ui_breakpoint eq 0 or (ui_is_portrait eq 1 and ui_breakpoint_v lt 5)"/>
  </subjects>
  <view name="current_mesh_card"
        extends="ui_card" width="100%" height="content" style_border_width="0" style_pad_all="0" flex_flow="column"
        scrollable="false">
    <!-- Card Header -->
    <lv_obj width="100%"
            height="content" flex_flow="row" style_flex_cross_place="center" style_pad_left="#space_md"
            style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_pad_gap="#space_sm"
            scrollable="false">
      <icon src="info" size="sm" variant="success"/>
      <text_body text="Current Mesh" flex_grow="1"/>
    </lv_obj>
    <!-- Divider -->
    <divider_horizontal/>
    <!-- Card Content -->
    <lv_obj width="100%"
            height="content" flex_flow="column" style_pad_all="#space_md" style_pad_gap="#space_xs" scrollable="false">
      <!-- Name row -->
      <lv_obj width="100%" flex_flow="row" style_pad_all="0" scrollable="false">
        <text_small text="Name"/>
        <text_small name="mesh_name_value"
                    bind_text="bed_mesh_profile_name" flex_grow="1" style_text_align="right" style_pad_left="#space_sm"
                    style_text_color="#success"/>
      </lv_obj>
      <!-- Size row -->
      <lv_obj width="100%" flex_flow="row" style_pad_all="0" scrollable="false">
        <text_small text="Size"/>
        <text_small name="mesh_size_value"
                    bind_text="bed_mesh_dimensions" flex_grow="1" style_text_align="right" style_pad_left="#space_sm"
                    style_text_color="#text"/>
      </lv_obj>
      <!-- Max row. Hidden per bed_mesh_hide_stat_rows (see <subjects> above):
           Z Range already conveys the spread, and a narrow OR vertically
           short column cannot afford five stat rows and a readable profiles
           list at once (prestonbrown/helixscreen#1204).

           Coordinates stay INLINE next to the label wherever they fit -
           that is the preferred, default rendering, unchanged from before
           this task in landscape (measured: 260px available in the 280px
           info column, "Max [125, 125]   0.288 mm" content_h stays a single
           22px line). Landscape must not grow taller, since current_mesh_card
           sits above profiles_card there and every extra line comes
           straight out of the profile list's height.

           Portrait's side-by-side info card is only #bed_mesh_portrait_info_width
           wide (200px at MEDIUM, ~180px of content after padding) - too
           narrow for label+coord+value on one line even after dropping the
           decimals (measured: the same inline probe wraps to a 44px/2-line
           box there). Only there does the coordinate fragment drop to its
           own indented, muted sub-line below, gated on ui_is_portrait since
           that is the one dimension that actually differs between the two
           shared-component arrangements. Same indent token and muted colour
           as the precedent "Act:" sub-row in ui_xml/motion_panel.xml, not a
           new treatment. bed_mesh_max_coord_ is empty (not "[]") when there
           is no mesh, so neither the inline nor the sub-line form renders an
           empty bracket pair in that state.

           Both fragments are always built and toggled with bind_flag_if_eq
           (cheap show/hide of an already-built leaf), not <if>/<else>: an
           <if> here would not be the last child of its row (value follows
           it), and a reactively-rebuilt <if> in that position re-appends
           its body to the END of the parent's child list on every flip
           (LVGL9_XML_GUIDE.md "Structural conditionals"), which would
           silently swap the coordinate fragment and the value's on-screen
           order the first time the printer rotates. bind_flag_if_eq only
           ever toggles LV_OBJ_FLAG_HIDDEN on a fixed widget, so the row's
           child order never moves. -->
      <lv_obj width="100%" flex_flow="column" style_pad_all="0" scrollable="false">
        <bind_flag_if_eq subject="bed_mesh_hide_stat_rows" flag="hidden" ref_value="1"/>
        <lv_obj width="100%" flex_flow="row" style_pad_all="0" scrollable="false">
          <text_small name="mesh_max_label" text="Max"/>
          <text_small name="mesh_max_coord_inline" bind_text="bed_mesh_max_coord" style_pad_left="#space_xxs">
            <bind_flag_if_eq subject="ui_is_portrait" flag="hidden" ref_value="1"/>
          </text_small>
          <text_small name="mesh_max_value"
                      bind_text="bed_mesh_max_value" flex_grow="1" style_text_align="right" style_pad_left="#space_sm"
                      style_text_color="#text"/>
        </lv_obj>
        <lv_obj width="100%" flex_flow="row" style_pad_all="0" style_pad_left="#space_md" scrollable="false">
          <bind_flag_if_eq subject="ui_is_portrait" flag="hidden" ref_value="0"/>
          <text_small name="mesh_max_coord_subline" bind_text="bed_mesh_max_coord" style_text_color="#text_muted"/>
        </lv_obj>
      </lv_obj>
      <!-- Min row. Hidden per bed_mesh_hide_stat_rows, same inline-vs-subline
           split as the Max row above - see its comment. -->
      <lv_obj width="100%" flex_flow="column" style_pad_all="0" scrollable="false">
        <bind_flag_if_eq subject="bed_mesh_hide_stat_rows" flag="hidden" ref_value="1"/>
        <lv_obj width="100%" flex_flow="row" style_pad_all="0" scrollable="false">
          <text_small name="mesh_min_label" text="Min"/>
          <text_small name="mesh_min_coord_inline" bind_text="bed_mesh_min_coord" style_pad_left="#space_xxs">
            <bind_flag_if_eq subject="ui_is_portrait" flag="hidden" ref_value="1"/>
          </text_small>
          <text_small name="mesh_min_value"
                      bind_text="bed_mesh_min_value" flex_grow="1" style_text_align="right" style_pad_left="#space_sm"
                      style_text_color="#text"/>
        </lv_obj>
        <lv_obj width="100%" flex_flow="row" style_pad_all="0" style_pad_left="#space_md" scrollable="false">
          <bind_flag_if_eq subject="ui_is_portrait" flag="hidden" ref_value="0"/>
          <text_small name="mesh_min_coord_subline" bind_text="bed_mesh_min_coord" style_text_color="#text_muted"/>
        </lv_obj>
      </lv_obj>
      <!-- Z Range row -->
      <lv_obj width="100%" flex_flow="row" style_pad_all="0" scrollable="false">
        <text_small text="Z Range"/>
        <text_small name="mesh_range_value"
                    bind_text="bed_mesh_variance" flex_grow="1" style_text_align="right" style_pad_left="#space_sm"
                    style_text_color="#text"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
