<component>
  <!--
    One MCU row of the Host Health widget's Full rung: the MCU's name, its load sparkline
    and its "load . retransmits" text. HostHealthWidget creates one per MCU the box holds.
  -->
  <api>
    <prop name="label" type="string" default=""/>
    <prop name="text_subject" type="string" default=""/>
    <prop name="spark_source" type="string" default=""/>
  </api>
  <view name="host_health_mcu_row"
        extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_main_place="start"
        style_flex_cross_place="center" style_pad_all="0" style_pad_column="#space_xs" style_bg_opa="0"
        style_border_width="0" scrollable="false" clickable="false" event_bubble="true">
    <text_tiny name="host_health_mcu_name"
               width="25%" long_mode="dots" text="$label" style_text_color="#text_muted" clickable="false"
               event_bubble="true"/>
    <helix_sparkline name="host_health_mcu_spark"
                     height="#space_lg" source="$spark_source" flex_grow="1" style_line_color="#primary"
                     clickable="false" event_bubble="true"/>
    <text_tiny name="host_health_mcu_text" bind_text="$text_subject" clickable="false" event_bubble="true"/>
  </view>
</component>
