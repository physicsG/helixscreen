<component>
  <!-- One plugin item in an app context menu: [icon] [label / reason].
       C++ creates one per resolved item and owns its tap payload; everything
       visual lives here. The label and reason are plugin text and travel through
       C++ (a leading '#' in a prop reads as a const). A disabled item is greyed,
       with its reason under the label, wrapped rather than cut short when the
       card is too narrow for it. -->
  <api>
    <prop name="icon" type="string" default="puzzle_outline"/>
    <prop name="disabled" type="string" default="false"/>
    <prop name="no_reason" type="string" default="true"/>
  </api>
  <styles>
    <style name="greyed" opa="128"/>
  </styles>
  <view extends="lv_obj"
        width="100%" height="content" style_min_height="#button_height_sm" flex_flow="row" style_flex_main_place="start"
        style_flex_cross_place="center" style_flex_track_place="center" style_pad_all="#space_sm"
        style_pad_gap="#space_sm" style_radius="#border_radius" style_bg_opa="0" style_border_width="0"
        scrollable="false" clickable="true" focusable="false" disabled="$disabled">
    <style name="styles.press_wash" selector="pressed"/>
    <style name="greyed" selector="disabled"/>
    <icon name="item_icon" src="$icon" size="sm" clickable="false" event_bubble="true"/>
    <lv_obj width="content"
            height="content" flex_grow="1" flex_flow="column" style_pad_all="0" style_pad_gap="0" style_bg_opa="0"
            style_border_width="0" scrollable="false" clickable="false" event_bubble="true">
      <text_body name="item_label" width="100%" text="" long_mode="dots" clickable="false" event_bubble="true"/>
      <text_small name="item_reason"
                  width="100%" text="" long_mode="wrap" hidden="$no_reason" style_text_color="#text_muted"
                  clickable="false" event_bubble="true"/>
    </lv_obj>
    <event_cb trigger="clicked" callback="plugin_menu_row_cb"/>
  </view>
</component>
