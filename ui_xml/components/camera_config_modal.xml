<component>
  <!-- Styles for reactive button selection (matches clog detection pattern) -->
  <styles>
    <style name="cam_btn_selected" bg_color="#primary" bg_opa="255"/>
    <style name="cam_btn_unselected" bg_color="#primary" bg_opa="40"/>
  </styles>

  <!-- Camera Configuration Modal
       Opened from grid edit mode gear icon on the camera widget.
       Source (which webcam), rotation and flip settings. -->
  <view name="camera_config_modal"
        extends="ui_dialog" width="60%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">

    <!-- Header -->
    <modal_header icon_src="cog" icon_variant="accent" title="Camera"/>

    <!-- Content: scrolls under the header and button row once the source
         list makes it taller than the dialog budget -->
    <lv_obj width="100%"
            height="content" style_max_height="#dialog_content_max" scrollable="true" style_pad_left="#space_lg"
            style_pad_right="#space_lg" style_pad_top="#space_sm" style_pad_bottom="#space_lg" flex_flow="column"
            style_pad_gap="#space_md">

      <!-- Source row: Automatic (the discovery auto-pick) plus one row per
           named webcam Moonraker lists, all from one repeat. Hidden when
           there is nothing to choose between (only the Automatic row). The
           note beside a name says what picking it gets: nothing = live
           stream, "Snapshot only", or "Unavailable". -->
      <lv_obj width="100%" height="content" flex_flow="column" style_pad_gap="#space_xs">
        <bind_flag_if_lt subject="cam_source_count" flag="hidden" ref_value="2"/>
        <text_small text="Source" style_text_color="#text_muted"/>
        <!-- Rows container: a subject-bound <repeat> must be its only child -->
        <lv_obj name="cam_source_rows"
                width="100%" height="content" scrollable="false" flex_flow="column" style_pad_all="0"
                style_pad_gap="#space_xs">
          <repeat count="cam_source_count">
            <lv_obj name="cam_source_${i}"
                    width="100%" height="content" clickable="true" scrollable="false" flex_flow="row"
                    style_flex_cross_place="center" style_pad_left="#space_sm" style_pad_right="#space_sm"
                    style_pad_top="#space_xs" style_pad_bottom="#space_xs" style_pad_gap="#space_sm"
                    style_radius="#border_radius_small" style_border_width="0">
              <style name="styles.press_wash" selector="pressed"/>
              <bind_style name="cam_btn_selected" subject="cam_source_${i}_active" ref_value="1"/>
              <bind_style name="cam_btn_unselected" subject="cam_source_${i}_active" ref_value="0"/>
              <text_small name="cam_source_${i}_name"
                          bind_text="cam_source_${i}_name" flex_grow="1" long_mode="dots" style_text_color="#text"/>
              <text_xs name="cam_source_${i}_note" bind_text="cam_source_${i}_note" style_text_color="#text_muted"/>
              <event_cb trigger="clicked" callback="on_cam_source_clicked" user_data="${i}"/>
            </lv_obj>
          </repeat>
        </lv_obj>
      </lv_obj>

      <!-- Rotation row -->
      <lv_obj width="100%" height="content" flex_flow="column" style_pad_gap="#space_xs">
        <text_small text="Rotation" style_text_color="#text_muted"/>
        <lv_obj width="100%" height="content" flex_flow="row" style_pad_gap="#space_xs">
          <ui_button name="btn_rot_0" text="0°" flex_grow="1" clickable="true">
            <bind_style name="cam_btn_selected" subject="cam_rot_0_active" ref_value="1"/>
            <bind_style name="cam_btn_unselected" subject="cam_rot_0_active" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_cam_rotate_0"/>
          </ui_button>
          <ui_button name="btn_rot_90" text="90°" flex_grow="1" clickable="true">
            <bind_style name="cam_btn_selected" subject="cam_rot_90_active" ref_value="1"/>
            <bind_style name="cam_btn_unselected" subject="cam_rot_90_active" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_cam_rotate_90"/>
          </ui_button>
          <ui_button name="btn_rot_180" text="180°" flex_grow="1" clickable="true">
            <bind_style name="cam_btn_selected" subject="cam_rot_180_active" ref_value="1"/>
            <bind_style name="cam_btn_unselected" subject="cam_rot_180_active" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_cam_rotate_180"/>
          </ui_button>
          <ui_button name="btn_rot_270" text="270°" flex_grow="1" clickable="true">
            <bind_style name="cam_btn_selected" subject="cam_rot_270_active" ref_value="1"/>
            <bind_style name="cam_btn_unselected" subject="cam_rot_270_active" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_cam_rotate_270"/>
          </ui_button>
        </lv_obj>
      </lv_obj>

      <!-- Flip row -->
      <lv_obj width="100%" height="content" flex_flow="column" style_pad_gap="#space_xs">
        <text_small text="Flip" style_text_color="#text_muted"/>
        <lv_obj width="100%" height="content" flex_flow="row" style_pad_gap="#space_xs">
          <ui_button name="btn_flip_h" text="Horizontal" flex_grow="1" clickable="true">
            <bind_style name="cam_btn_selected" subject="cam_flip_h_active" ref_value="1"/>
            <bind_style name="cam_btn_unselected" subject="cam_flip_h_active" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_cam_flip_h_toggled"/>
          </ui_button>
          <ui_button name="btn_flip_v" text="Vertical" flex_grow="1" clickable="true">
            <bind_style name="cam_btn_selected" subject="cam_flip_v_active" ref_value="1"/>
            <bind_style name="cam_btn_unselected" subject="cam_flip_v_active" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_cam_flip_v_toggled"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
    </lv_obj>

    <!-- Buttons -->
    <modal_button_row secondary_text="Cancel"
                      secondary_callback="on_modal_cancel_clicked" primary_text="Save"
                      primary_callback="on_modal_ok_clicked"/>
  </view>
</component>
