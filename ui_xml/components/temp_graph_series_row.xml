<!-- One series in the temp graph widget's settings dialog: a colour swatch
     (tap to cycle the palette), the sensor's name and an on/off switch. Bound
     to the temp_graph_cfg_<index>_name, _color and _on subjects the dialog
     publishes; the swatch and the switch report their row index to
     temp_graph_series_swatch_cb and temp_graph_series_switch_cb. -->
<component>
  <api>
    <prop name="index" type="string" default="0"/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_flex_track_place="center" style_pad_ver="#space_xs" style_pad_gap="#space_md">
    <color_swatch name="sensor_swatch_${index}"
                  index="$index" color_subject="temp_graph_cfg_${index}_color" size="#space_xl" reach="0" hit="0"
                  callback="temp_graph_series_swatch_cb"/>
    <text_body name="sensor_name_${index}" bind_text="temp_graph_cfg_${index}_name" flex_grow="1"/>
    <!-- SIZE_OK: the switch keeps the 44x24 it always had, with no margin around it -->
    <lv_switch name="sensor_switch_${index}" width="44" height="24">
      <bind_state_if_eq subject="temp_graph_cfg_${index}_on" state="checked" ref_value="1"/>
      <event_cb trigger="value_changed" callback="temp_graph_series_switch_cb" user_data="$index"/>
    </lv_switch>
  </view>
</component>
