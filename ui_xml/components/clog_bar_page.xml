<component>
  <!--
    FlowGuard bar page for carousel embedding (#1017).

    The wide counterpart to clog_meter_page.xml's arc: at the widget's 2x1
    default there is width to spare and no height, which is the shape a
    horizontal scale wants and an arc does not.

    This is only the centring shell that fills a carousel cell. The bar is
    clog_bar_body.xml, which the Buffer Status modal embeds directly.
  -->
  <view name="clog_bar_page"
        extends="lv_obj" width="100%" height="100%" style_pad_all="0" style_pad_row="#space_xs" style_pad_column="0"
        scrollable="false" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center"
        clickable="false" event_bubble="true">
    <clog_bar_body/>
  </view>
</component>
