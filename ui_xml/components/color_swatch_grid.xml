<!-- The 30-swatch preset color grid (row_wrap, 6 columns x 5 rows), for either
     of ColorPicker's palettes, named by the palette prop:

       general  filament, LED and general use (the default).
       theme    the theme editor's presets, structured for the 16 role tokens:
                rows 1-2 a 12-step surface ramp, dark -> light, alternating
                cool/warm/neutral tint (screen_bg / overlay_bg / card_bg /
                elevated_bg / border / text_subtle / text_muted / text);
                rows 3-5 six hue families x 3 tones, COLUMN IS THE HUE FAMILY
                (red, amber, green, teal, blue, violet) and row is the tone
                (muted for dark mode, mid, deep for light mode). Drawn from the
                tones the shipped themes occupy, so a preset click lands near a
                real theme value. tests/unit/test_theme_swatch_grid.cpp pins
                the ordering.

     The values live in swatch_palette(), published as <palette>_swatch_color_<i>;
     the fixed count matches it.

     lead_hidden="false" shows the app's rainbow custom-colour swatch first,
     ahead of the presets, calling lead_callback. Hidden by default, it takes
     no place in the grid. -->
<component>
  <api>
    <!-- Required: each host names its own click handler. No default on purpose —
         an implicit AMS-specific default (ams_edit_color_swatch_cb) would
         silently bind an unrelated screen's swatches to the AMS overlay's
         handler (get_ams_edit_overlay()), coupling instances across screens. -->
    <prop name="swatch_callback" type="string"/>
    <!-- "general" or "theme": the subject prefix of the palette shown. -->
    <prop name="palette" type="string" default="general"/>
    <!-- Int subject naming the ringed swatch; empty for a grid with no selection. -->
    <prop name="selected_subject" type="string" default=""/>
    <!-- Sizing tokens: a host with room of its own (the tabbed picker) passes larger
         ones; the columns follow from the grid's width. -->
    <prop name="swatch_size" type="string" default="#swatch_grid_size"/>
    <prop name="gap" type="string" default="#swatch_grid_gap"/>
    <prop name="gap_half" type="string" default="#swatch_grid_gap_half"/>
    <prop name="lead_hidden" type="string" default="true"/>
    <prop name="lead_callback" type="string" default=""/>
  </api>
  <view name="color_swatch_grid"
        extends="lv_obj" width="#swatch_grid_width" height="content" style_pad_all="0" flex_flow="row_wrap"
        style_pad_gap="$gap" style_flex_main_place="center" scrollable="false">
    <custom_color_swatch name="btn_custom_color_lead"
                         hidden="$lead_hidden" selected_subject="$selected_subject" callback="$lead_callback"
                         size="$swatch_size" hit="$gap_half"/>
    <repeat count="30">
      <color_swatch index="${i}"
                    color_subject="${palette}_swatch_color_${i}" selected_subject="$selected_subject"
                    callback="$swatch_callback" size="$swatch_size" hit="$gap_half" reach="#swatch_grid_ring_reach"
                    ring="styles.grid_swatch_ring"/>
    </repeat>
  </view>
</component>
