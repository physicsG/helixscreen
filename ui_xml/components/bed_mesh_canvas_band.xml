<component>
  <!-- The 3D mesh canvas plus its "No mesh loaded" empty-state overlay.
       Shared between bed_mesh_panel.xml's landscape and portrait <if>/<else>
       branches (like bed_mesh_current_mesh_card.xml / bed_mesh_profiles_card.xml
       already are) - the two arrangements size this band differently
       (portrait: fixed width, 45% height; landscape: flex_grow, 100% height)
       but the canvas, the empty-state icon, and its translatable "No mesh
       loaded" string were previously pasted into both branches verbatim. A
       duplicated translatable string is the worst version of this:
       translators see it twice and the copies can drift with no gate able to
       see it, since the existing string/i18n gates compare across files, not
       within one. Only width/height/flex_grow differ, so they are
       overridden at each instantiation site rather than declared as <api>
       props. -->
  <view name="canvas_wrapper" extends="lv_obj" width="100%" height="100%" style_pad_all="0" scrollable="false">
    <bed_mesh name="bed_mesh_canvas" width="100%" height="100%" clickable="true" style_border_width="0"/>
    <!-- Empty state overlay - absolutely positioned centered over canvas -->
    <centered_column name="no_mesh_overlay" width="content" height="content" align="center">
      <bind_flag_if_eq subject="bed_mesh_available" flag="hidden" ref_value="1"/>
      <icon src="grid_off" size="lg" variant="muted"/>
      <text_muted text="No mesh loaded" style_pad_top="#space_md"/>
    </centered_column>
  </view>
</component>
