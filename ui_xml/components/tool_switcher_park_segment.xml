<!-- Docks the mounted tool: an outlined cell beside the heads, in the rail
     after them, beside the mounted head's face, or in the picker's footer. Its
     caller sizes it. Disabled
     while nothing is mounted (active_tool is -1) and, through moves_machine,
     while a job holds the machine; it keeps its cell either way, so the rail
     never changes width. -->
<component>
  <api>
    <!-- 1 where the cell has room for its label under the icon. -->
    <prop name="two_line" type="string" default="tool_switcher_two_line"/>
  </api>
  <styles>
    <style name="park_disabled" opa="50%"/>
  </styles>
  <view extends="lv_obj"
        flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center"
        style_flex_track_place="center" style_pad_all="0" style_pad_gap="0" style_radius="0" style_bg_opa="0"
        style_border_width="2" style_border_color="#primary" clickable="true" scrollable="false" moves_machine="true">
    <style name="styles.press_wash" selector="pressed"/>
    <style name="park_disabled" selector="disabled"/>
    <bind_state_if_lt subject="active_tool" state="disabled" ref_value="0"/>
    <icon name="tool_switcher_park_icon" src="eject" size="sm" variant="primary" clickable="false" event_bubble="true"/>
    <text_small name="tool_switcher_park_label" text="Park" clickable="false" event_bubble="true">
      <bind_flag_if_eq subject="$two_line" flag="hidden" ref_value="0"/>
    </text_small>
    <event_cb trigger="clicked" callback="tool_switcher_park_cb"/>
  </view>
</component>
