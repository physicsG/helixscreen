<!-- One home carousel page: the grid container the page's widgets are placed in.
     Clickable so a press on empty grid space has a target, and bubbling so that
     press reaches the edit-mode handlers on carousel_host. -->
<component>
  <view extends="lv_obj"
        width="100%" height="100%" style_pad_all="#space_sm" style_border_width="0" style_bg_opa="0" scrollable="false"
        clickable="true" event_bubble="true"/>
</component>
