<!-- A soft disc of `color` over a part of the printer picture, positioned and
     sized by the owner's callout layout. Strong while tone_subject is 1
     (Active: heating, spinning, on), soft otherwise; shown_subject 0 hides it. -->
<component>
  <api>
    <prop name="tone_subject" type="subject" default=""/>
    <prop name="shown_subject" type="subject" default=""/>
    <prop name="color" type="string" default="#info"/>
  </api>
  <styles>
    <style name="glow_soft" bg_opa="40"/>
    <style name="glow_strong" bg_opa="110"/>
  </styles>
  <view extends="lv_obj"
        style_radius="32767" style_bg_color="$color" style_border_width="0" scrollable="false" clickable="false">
    <style name="glow_soft"/>
    <bind_style_if_eq name="glow_strong" subject="$tone_subject" ref_value="1"/>
    <bind_flag_if_eq subject="$shown_subject" flag="hidden" ref_value="0"/>
  </view>
</component>
