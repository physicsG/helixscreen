<component>
  <!-- One queued job in the job queue modal: [filename / queued-for .... ] [trash].
       Tapping the row starts the job; the trash icon intercepts its own tap
       (clickable, no event_bubble) and removes it. C++ hangs the job id and
       filename on the row's user_data, which both callbacks read, and sets the
       filename text itself: it is user text, and as a prop a leading '#' would
       read as a const. The home tile reuses the row read-only: hide_delete drops
       the trash icon, row_clickable false makes a tap fall through to the tile, and
       name_subject binds the name to a subject instead. -->
  <api>
    <prop name="queued_text" type="string" default=""/>
    <prop name="hide_queued" type="boolean" default="true"/>
    <prop name="hide_delete" type="boolean" default="false"/>
    <prop name="row_clickable" type="boolean" default="true"/>
    <prop name="name_subject" type="string" default=""/>
  </api>
  <styles>
    <style name="delete_pressed" text_color="#text"/>
  </styles>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_main_place="space_between"
        style_flex_cross_place="center" style_bg_color="#card_bg" style_bg_opa="255" style_radius="6"
        style_border_width="0" style_pad_all="#space_sm" style_pad_gap="#space_sm" scrollable="false"
        clickable="$row_clickable">
    <style name="styles.press_wash" selector="pressed"/>
    <event_cb trigger="clicked" callback="on_jq_row_start"/>
    <pass_through height="content" flex_grow="1" flex_flow="column" style_pad_gap="#space_xxs">
      <text_body name="job_filename" width="100%" text="" bind_text="$name_subject" long_mode="dots"/>
      <lv_label name="job_queued"
                text="$queued_text" hidden="$hide_queued" style_text_font="#font_small" style_text_color="#text_muted"/>
    </pass_through>
    <lv_label name="job_delete"
              text="#icon_trash_can_outline" style_text_font="#icon_font_sm" style_text_color="#danger"
              style_pad_all="#space_xs" clickable="true" hidden="$hide_delete">
      <style name="delete_pressed" selector="pressed"/>
      <event_cb trigger="clicked" callback="on_jq_row_delete"/>
    </lv_label>
  </view>
</component>
