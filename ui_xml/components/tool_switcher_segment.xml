<!-- One head's cell, in the tool switcher rail and in the picker grid, bound
     to the tool_switcher_seg_<index>_* subjects the widget publishes. The
     surface names its own size, band, second-line and label subjects through
     the props, so both draw the same cell at their own size. The widget sizes
     every cell (never under the touch floor) and measures each label against
     the cell less #space_xs on each side, which is the padding the labels
     carry here. Square: the rail clips its outer corners.

     Its look follows tool_switcher_seg_<index>_state (ToolSwitcherCellState):
     idle, mounted, or faulted while the changer reports an error.

     A tap on a head that is not mounted mounts it; a tap on the mounted head
     opens the picker. Disabled while tool_switcher_change_blocked: a print that
     refuses the switch, or spools on the bed. Not moves_machine, which also
     holds through a pause, where a head change is offered behind its
     confirmation. -->
<component>
  <api>
    <prop name="index" type="string" default="0"/>
    <!-- Prefix of the surface's <size>_w and <size>_h subjects. -->
    <prop name="size" type="string" default="tool_switcher_cell"/>
    <!-- The surface's band subjects (tool_switcher_band.xml). -->
    <prop name="band_h" type="string" default="tool_switcher_band_h"/>
    <prop name="band_labelled" type="string" default="tool_switcher_band_labelled"/>
    <!-- 1 where the cell holds its second line. -->
    <prop name="two_line" type="string" default="tool_switcher_two_line"/>
    <!-- Suffixes of the per-head label and second-line subjects. -->
    <prop name="label_key" type="string" default="_label"/>
    <prop name="sub_key" type="string" default="_sub"/>
  </api>
  <styles>
    <!-- Not inline: an inline bg_color would outrank the bound fills. -->
    <style name="seg_idle" bg_color="#elevated_bg" bg_opa="255"/>
    <style name="seg_mounted" bg_color="#primary"/>
    <style name="seg_mounted_text" text_color="#text_on_primary"/>
    <!-- A faulted cell fills its text area, not the band's row, and draws the
         cell's own background as a 2 px rule above the band, so a red filament
         band still reads against the red. -->
    <style name="seg_area_clear" bg_opa="0" border_width="0"/>
    <style name="seg_area_fault"
           bg_color="#danger" bg_opa="255" border_side="bottom" border_width="2" border_color="#elevated_bg"/>
    <style name="seg_fault_text" text_color="#text_on_danger"/>
    <style name="seg_disabled" opa="50%"/>
  </styles>
  <view extends="lv_obj"
        flex_flow="column" style_pad_all="0" style_pad_gap="0" style_radius="0" style_border_width="0" clickable="true"
        scrollable="false">
    <bind_style_prop prop="width" subject="${size}_w"/>
    <bind_style_prop prop="height" subject="${size}_h"/>
    <style name="seg_idle"/>
    <style name="styles.press_wash" selector="pressed"/>
    <style name="seg_disabled" selector="disabled"/>
    <bind_style_if_eq name="seg_mounted" subject="tool_switcher_seg_${index}_state" ref_value="1"/>
    <bind_state_if_eq subject="tool_switcher_change_blocked" state="disabled" ref_value="1"/>
    <lv_obj name="tool_switcher_seg_text"
            width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center"
            style_flex_track_place="center" style_pad_all="0" style_pad_gap="0" style_radius="0" clickable="false"
            event_bubble="true" scrollable="false">
      <style name="seg_area_clear"/>
      <bind_style_if_eq name="seg_area_fault" subject="tool_switcher_seg_${index}_state" ref_value="2"/>
      <text_body name="tool_switcher_seg_label"
                 width="content" style_max_width="100%" style_pad_hor="#space_xs" long_mode="dots"
                 bind_text="tool_switcher_seg_${index}${label_key}" style_text_align="center" clickable="false"
                 event_bubble="true">
        <bind_style_if_eq name="seg_mounted_text" subject="tool_switcher_seg_${index}_state" ref_value="1"/>
        <bind_style_if_eq name="seg_fault_text" subject="tool_switcher_seg_${index}_state" ref_value="2"/>
      </text_body>
      <!-- "T0" under a full label, the temperature under a code label (or
           always the temperature, in the picker): a second line shown only
           where the cell is tall and wide enough. -->
      <text_small name="tool_switcher_seg_sub"
                  width="content" style_max_width="100%" style_pad_hor="#space_xs" long_mode="dots"
                  bind_text="tool_switcher_seg_${index}${sub_key}" style_text_align="center" clickable="false"
                  event_bubble="true">
        <bind_flag_if_eq subject="$two_line" flag="hidden" ref_value="0"/>
        <bind_style_if_eq name="seg_mounted_text" subject="tool_switcher_seg_${index}_state" ref_value="1"/>
        <bind_style_if_eq name="seg_fault_text" subject="tool_switcher_seg_${index}_state" ref_value="2"/>
      </text_small>
    </lv_obj>
    <tool_switcher_band name="tool_switcher_seg_band"
                        band_h="$band_h" band_labelled="$band_labelled" color="tool_switcher_seg_${index}_color"
                        colors="tool_switcher_seg_${index}_colors" finish="tool_switcher_seg_${index}_finish"
                        has_color="tool_switcher_seg_${index}_has_color" text="tool_switcher_seg_${index}_material"
                        text_color="tool_switcher_seg_${index}_band_text"/>
    <event_cb trigger="clicked" callback="tool_switcher_segment_cb" user_data="$index"/>
  </view>
</component>
