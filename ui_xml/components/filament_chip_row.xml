<component>
  <!-- The FILAMENTS card's chips: filament_chip_count filament_swatch chips in
       one row, then the "+N" pill when more tools are used than the row holds.
       FilamentMappingCard publishes the count, each chip's subjects and the
       pill's count; it creates no widget. The chips sit in their own container
       because a subject-bound <repeat> must be the only child of its parent. -->
  <view extends="lv_obj"
        width="content" height="100%" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
        style_pad_gap="#space_xs" style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false"
        event_bubble="true">
    <lv_obj name="filament_chips"
            width="content" height="100%" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xs" style_bg_opa="0"
            style_border_width="0" scrollable="false" clickable="false" event_bubble="true">
      <repeat count="filament_chip_count">
        <filament_swatch name="filament_chip_${i}" index="${i}"/>
      </repeat>
    </lv_obj>
    <filament_mapping_more_pill name="filament_chip_more" width="#filament_chip_width" height="100%">
      <bind_flag_if_eq subject="filament_chip_more_count" flag="hidden" ref_value="0"/>
    </filament_mapping_more_pill>
  </view>
</component>
