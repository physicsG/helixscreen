<component>
  <!-- Chamber-heater diagnostics card (issue #1290): fault/inhibited banner
       with a Reset action, heating-element + filter-fan readouts, and the
       filter-fan toggle. Rendered by temp_graph_overlay below the chart.

       Data arrives exclusively through global subjects and both buttons fire
       TemperatureService XML callbacks that delegate to the globally
       registered TemperatureController — nothing here is instance-specific,
       which is what lets the overlay instantiate it in one place for both
       orientations.

       The caller owns outer visibility: instantiate inside
       <if cond="printer_has_chamber_heater_diagnostics and temp_graph_mode eq 3">
       so non-chamber printers never build the subtree. The two inner gates
       (banner on fault-or-inhibited, toggle on the filter-fan capability)
       are bind-based because they flip at runtime.

       Orientation is a structural branch (nozzle_control_strip pattern):
       landscape keeps the comfortable stacked layout; portrait collapses to
       a compact variant — the tightest target (272x480 chamber mode) has
       ~300px for chart + card, and the stacked layout (~120px unfaulted,
       ~190px faulted) pushed the card below a scroll. Compact is a single
       info row with the fan toggle inline (icon button driven by the
       chamber_filter_fan_icon subject) plus a condensed one-line banner.
       Names repeat across the if/else branches;
       check_duplicate_xml_names.py skips branch pairs by design. -->
  <styles>
    <!-- Padding axis is bound (not inline on the view) so the compact branch
         can tighten it — an inline style_pad_all would outrank the bind. -->
    <style name="cdc_pad_roomy" style_pad_all="#space_sm" style_pad_gap="#space_xs"/>
    <style name="cdc_pad_compact" style_pad_all="#space_xs" style_pad_gap="#space_xxs"/>
  </styles>
  <view name="chamber_diagnostics_card"
        extends="ui_card" width="100%" height="content" style_margin_top="#space_sm" flex_flow="column">
    <bind_style_if name="cdc_pad_compact" cond="ui_is_portrait"/>
    <bind_style_if name="cdc_pad_roomy" cond="ui_is_portrait" invert="true"/>
    <if cond="ui_is_portrait eq 0">
      <!-- LANDSCAPE: comfortable stacked layout — banner, readout pair,
           full-width toggle button. -->
      <!-- Fault / inhibited banner -->
      <lv_obj name="fault_banner"
              width="100%" height="content" flex_flow="row" style_pad_all="#space_xs" style_pad_gap="#space_xs"
              style_flex_cross_place="center" scrollable="false" style_bg_color="#danger" style_bg_opa="25"
              style_radius="#border_radius_sm" style_border_width="#border_width" style_border_color="#danger">
        <bind_flag_if cond="chamber_heater_fault or chamber_heater_inhibited" flag="hidden" invert="true"/>
        <text_small name="fault_reason_label"
                    bind_text="chamber_heater_fault_reason_text" style_text_color="#danger" flex_grow="1"/>
        <ui_button name="reset_fault_button" text="Reset" translation_tag="Reset" variant="secondary">
          <event_cb trigger="clicked" callback="on_chamber_fault_reset_clicked"/>
        </ui_button>
      </lv_obj>
      <!-- Info row: heating-element temp + filter fan speed -->
      <lv_obj width="100%" height="content" flex_flow="row" style_pad_gap="#space_md" scrollable="false">
        <lv_obj height="content" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_muted text="Element" translation_tag="Element"/>
          <text_small name="element_temp_label" bind_text="chamber_heater_element_temp_text"/>
        </lv_obj>
        <lv_obj height="content" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_muted text="Filter Fan" translation_tag="Filter Fan"/>
          <text_small name="fan_percent_label" bind_text="chamber_filter_fan_percent_text"/>
        </lv_obj>
      </lv_obj>
      <!-- Filter fan toggle — only when the backend wires a filter-fan pin -->
      <ui_button name="filter_fan_button" width="100%" variant="ghost" bind_text="chamber_filter_fan_on_text">
        <bind_flag_if_eq subject="printer_has_chamber_filter_fan" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_chamber_filter_fan_clicked"/>
      </ui_button>
      <else/>
      <!-- PORTRAIT: compact variant sized so chart + card fit the ~300px a
           272x480 window leaves — no scroll. Banner is one condensed row
           (reason + small Reset); readouts share a single row with the fan
           toggle as a small icon button instead of a stacked full-width
           button. -->
      <lv_obj name="fault_banner"
              width="100%" height="content" flex_flow="row" style_pad_all="#space_xxs" style_pad_gap="#space_xs"
              style_flex_cross_place="center" scrollable="false" style_bg_color="#danger" style_bg_opa="25"
              style_radius="#border_radius_sm" style_border_width="#border_width" style_border_color="#danger">
        <bind_flag_if cond="chamber_heater_fault or chamber_heater_inhibited" flag="hidden" invert="true"/>
        <text_small name="fault_reason_label"
                    bind_text="chamber_heater_fault_reason_text" style_text_color="#danger" flex_grow="1"/>
        <ui_button name="reset_fault_button"
                   height="#button_height_sm_tiny" text="Reset" translation_tag="Reset" variant="ghost"
                   style_pad_left="#space_xs" style_pad_right="#space_xs" style_border_width="#border_width"
                   style_border_color="#border" style_border_opa="255">
          <event_cb trigger="clicked" callback="on_chamber_fault_reset_clicked"/>
        </ui_button>
      </lv_obj>
      <lv_obj width="100%"
              height="content" flex_flow="row" style_pad_gap="#space_md" style_flex_cross_place="center"
              scrollable="false">
        <lv_obj height="content" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_muted text="Element" translation_tag="Element"/>
          <text_small name="element_temp_label" bind_text="chamber_heater_element_temp_text"/>
        </lv_obj>
        <lv_obj height="content" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_muted text="Filter Fan" translation_tag="Filter Fan"/>
          <text_small name="fan_percent_label" bind_text="chamber_filter_fan_percent_text"/>
        </lv_obj>
        <lv_obj height="1" flex_grow="1" style_pad_all="0" scrollable="false" style_border_opa="0"/>
        <ui_button name="filter_fan_button"
                   width="#icon_button_size" height="#icon_button_size" variant="ghost"
                   bind_icon="chamber_filter_fan_icon" style_border_width="#border_width" style_border_color="#border"
                   style_border_opa="255">
          <bind_flag_if_eq subject="printer_has_chamber_filter_fan" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_chamber_filter_fan_clicked"/>
        </ui_button>
      </lv_obj>
    </if>
  </view>
</component>
