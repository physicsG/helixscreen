<component>
  <!-- The mini exclude-object map: outlines only, in a normal layout slot. The map view
       adds the canvas under plate_area. Nothing here takes a tap, so a tile that holds it
       keeps the touch. -->
  <view name="exclude_object_map_mini"
        extends="lv_obj" style_width="100%" style_height="100%" style_pad_all="0" style_bg_opa="0"
        style_border_width="0" scrollbar_mode="off" scrollable="false" clickable="false" event_bubble="true">
    <lv_obj name="plate_area"
            style_width="100%" style_height="100%" style_bg_color="#card_bg" style_bg_opa="40" style_border_width="0"
            style_radius="#border_radius_small" style_pad_all="0" scrollable="false" clickable="false"
            event_bubble="true"/>
  </view>
</component>
