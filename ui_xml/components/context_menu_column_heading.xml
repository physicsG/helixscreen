<component>
  <!-- One column group's heading in a context menu card: a muted label over a
       rule. Every column of a card uses it, so their headings and rows line up
       across the card. The text comes in as a prop with its translation tag; a
       plugin's name is plugin text and C++ sets it on heading_text instead. -->
  <api>
    <prop name="text" type="string" default=""/>
    <prop name="text_tag" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" style_pad_all="0" style_pad_gap="#space_xs" flex_flow="column" style_bg_opa="0"
        style_border_width="0" scrollable="false" clickable="false">
    <text_small name="heading_text"
                width="100%" text="$text" translation_tag="$text_tag" long_mode="dots" style_text_color="#text_muted"
                clickable="false"/>
    <lv_obj width="100%"
            height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"
            clickable="false"/>
  </view>
</component>
