<component>
  <!-- A pill-shaped choice in a picker's wrap-flow chip row (the power device
       widget's energy sensor). Outlined at rest, primary-outlined and tinted
       while it is the current choice; `selected` maps to LV_STATE_CHECKED.
       C++ hangs the choice's value on user_data, sets the label (sensor names are
       user text, and as a prop a leading '#' would read as a const) and wires
       the click. -->
  <api>
    <prop name="selected" type="boolean" default="false"/>
  </api>
  <styles>
    <style name="selected" border_width="2" border_color="#primary" bg_color="#primary" bg_opa="20"/>
  </styles>
  <view extends="lv_obj"
        width="content" height="content" style_pad_ver="#space_xs" style_pad_hor="#space_sm" style_radius="12"
        style_border_width="1" style_border_color="#border" style_bg_opa="0" scrollable="false" clickable="true"
        checked="$selected">
    <style name="selected" selector="checked"/>
    <style name="styles.press_wash" selector="pressed"/>
    <lv_label name="chip_label"
              text="" style_text_font="noto_sans_14" style_text_color="#text" clickable="false" event_bubble="true"/>
  </view>
</component>
