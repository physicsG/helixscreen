<component>
  <!-- The arrow layouts' step selector: one button per configured jog
       distance, ascending, the selected one solid. MotionPanel publishes the
       count, labels and selection; the repeat rebuilds when the count changes,
       so it is the only child here. MotionPanel::fit_jog_layout() sets the
       bar's width, so each step key stays near square. -->
  <view name="motion_step_bar"
        extends="lv_obj" width="content" height="content" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
        scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
    <repeat count="motion_step_count">
      <ui_button name="step_${i}"
                 width="0" flex_grow="1" style_min_width="0" style_min_height="#touch_target_min"
                 style_pad_hor="#space_xxs" style_pad_ver="0" bind_text="motion_step_label_${i}">
        <bind_style name="styles.choice_selected" subject="motion_step_active_${i}" ref_value="1"/>
        <bind_style name="styles.choice_idle" subject="motion_step_active_${i}" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_motion_step_clicked" user_data="$i"/>
      </ui_button>
    </repeat>
  </view>
</component>
