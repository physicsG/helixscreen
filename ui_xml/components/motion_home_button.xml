<component>
  <!-- A motion layout's home key. `axis` names the axes it homes (X, Y, Z,
       XY, or all); `needs_home` is the expression that is true while one of
       them is unhomed, which draws the key solid. Disabled while a job holds
       the machine. The button lays out its icon and text when it is created,
       so those are props too. -->
  <api>
    <prop name="axis" type="string" default="all"/>
    <prop name="needs_home" type="string" default="0"/>
    <prop name="text" type="string" default=""/>
    <prop name="icon" type="string" default="home"/>
  </api>
  <view extends="ui_button" style_min_width="0" icon="$icon" text="$text" moves_machine="true">
    <!-- Idle first, solid after: the later style wins while it is enabled. -->
    <style name="styles.choice_idle"/>
    <bind_style_if name="styles.choice_selected" cond="$needs_home"/>
    <event_cb trigger="clicked" callback="on_motion_home" user_data="$axis"/>
  </view>
</component>
