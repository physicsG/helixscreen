<component>
  <api>
    <!-- Per-instance rung subject from the owning tile. Empty by default, so
         a call site that does not size itself installs no binding and keeps
         whatever `size` selects. -->
    <prop name="rung_subject" type="string" default=""/>
    <prop name="size" type="string" default="#icon_size"/>
    <prop name="src" type="string" default="radiator"/>
    <!-- No sensible default: every instance MUST pass glyph_name explicitly
         (see note below on why it stays empty rather than defaulting to
         "bed_icon_glyph"). -->
    <prop name="glyph_name" type="string" default=""/>
  </api>
  <!--
    Heater Icon (heatbed / chamber)

    One component for every non-nozzle heater glyph. The nozzle has its own
    component because it also carries a tool badge.

    glyph_name MUST be the name HeaterIconBinder::default_icon_name() expects for
    that heater — "bed_icon_glyph" or "chamber_icon_glyph". A wrong or missing
    name fails silently: the binder simply does not find the icon under that
    name and the thermal tint never appears — nothing crashes, nothing warns
    louder than a debug log. glyph_name has no default (deliberately empty)
    so a caller that forgets it gets an icon named "" instead of a second,
    silently-colliding "bed_icon_glyph" that steals the tint from the real one.

    Colour is owned by HeatingIconAnimator once bound (4-state thermal tint); the
    variant here is only the pre-bind resting appearance.
  -->
  <view name="heater_icon"
        width="content" height="content" style_pad_all="0" scrollable="false" clickable="false" event_bubble="true">
    <icon name="$glyph_name" src="$src" size="$size" variant="secondary" clickable="false" event_bubble="true">
      <!-- The heating pulse animates this glyph, so it never takes the scaled path -->
      <bind_tile_rung ladder="icon" subject="$rung_subject" animated="true"/>
    </icon>
  </view>
</component>
