<component>
  <api>
    <!-- Per-instance subject names, supplied by the widget at creation. They
         must exist before this component is parsed: a binding whose subject is
         missing at parse time is dropped permanently and silently. -->
    <prop name="tile_icon_subject" type="string" default=""/>
    <prop name="tile_label_subject" type="string" default=""/>
    <prop name="tile_dir_subject" type="string" default=""/>
    <prop name="tile_target_subject" type="string" default=""/>
  </api>
  <view name="panel_widget_filament"
        extends="lv_obj" height="100%" flex_grow="1" style_pad_ver="0" style_pad_gap="#space_xxs" scrollable="false"
        clickable="true">
    <style name="styles.tile_column"/>
    <bind_style_if_eq name="styles.tile_row" subject="$tile_dir_subject" ref_value="1"/>
    <event_cb trigger="clicked" callback="filament_widget_clicked_cb"/>
    <!-- Hardware gate (filament_sensor_count) checked in C++ populate_widgets().
         filament_tile_state mirrors whichever role subject the user selected;
         it is owned by FilamentSensorWidget. -->
    <filament_sensor_indicator size="#icon_size"
                               subject="filament_tile_state" rung_subject="$tile_icon_subject" clickable="false"
                               event_bubble="true"/>
    <text_tiny text="Loaded" style_text_align="center" clickable="false" event_bubble="true">
      <bind_tile_rung ladder="label" subject="$tile_icon_subject"/>
      <bind_flag_if_not_eq subject="filament_tile_state" flag="hidden" ref_value="1"/>
      <bind_flag_if_eq subject="show_widget_labels" flag="hidden" ref_value="0"/>
      <bind_flag_if_eq subject="$tile_label_subject" flag="hidden" ref_value="0"/>
    </text_tiny>
    <text_tiny text="Empty" style_text_align="center" clickable="false" event_bubble="true">
      <bind_tile_rung ladder="label" subject="$tile_icon_subject"/>
      <bind_flag_if_not_eq subject="filament_tile_state" flag="hidden" ref_value="0"/>
      <bind_flag_if_eq subject="show_widget_labels" flag="hidden" ref_value="0"/>
      <bind_flag_if_eq subject="$tile_label_subject" flag="hidden" ref_value="0"/>
    </text_tiny>
    <text_tiny text="Off" style_text_align="center" clickable="false" event_bubble="true">
      <bind_tile_rung ladder="label" subject="$tile_icon_subject"/>
      <bind_flag_if_not_eq subject="filament_tile_state" flag="hidden" ref_value="2"/>
      <bind_flag_if_eq subject="show_widget_labels" flag="hidden" ref_value="0"/>
      <bind_flag_if_eq subject="$tile_label_subject" flag="hidden" ref_value="0"/>
    </text_tiny>
  </view>
</component>
