<component>
  <!-- bed_mesh_profile_row_height_* responsive tokens live in
       bed_mesh_panel.xml, not here — theme_manager_find_xml_files() only
       scans top-level ui_xml/*.xml for the auto-discovery that turns
       "_micro"/"_tiny"/... suffixed <px> entries into the responsive
       #bed_mesh_profile_row_height token (check_responsive_token_scope.py
       enforces this); a components/ subdirectory declaration is silently
       invisible to it. The resulting token is still globally resolvable
       from here once declared there. -->
  <styles>
    <!-- Highlight for the currently loaded/active profile row. Applied via
         bind_style_if_eq on each row's bed_mesh_profile_N_active subject so the
         loaded profile reads as "selected" (raised surface + subtle accent
         border), matching the elevated-surface convention used elsewhere. -->
    <style name="profile_row_active"
           bg_opa="255" bg_color="#elevated_bg" border_width="1" border_color="#primary" border_opa="180"/>
  </styles>
  <!-- style_min_height is a second, defensive floor underneath the
       reservation BedMeshPanel::apply_portrait_canvas_height already makes
       for this card before sizing the canvas (see that function). It should
       never bind given that reservation is correct; it is cheap insurance
       against the reservation being wrong on some screen size not covered
       by testing, so this card degrades to "very short but present" rather
       than "gone" — and it is a no-op in landscape, where this card is
       always well above it already. -->
  <view name="profiles_card"
        extends="ui_card" width="100%" flex_grow="1" style_border_width="0" style_pad_all="0" flex_flow="column"
        style_min_height="90" scrollable="false">
    <!-- Card Header. Named so BedMeshPanel::apply_portrait_canvas_height can
         measure its real rendered height (icon size and padding both vary by
         breakpoint) rather than guessing a constant. -->
    <lv_obj name="profiles_card_header"
            width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_left="#space_md"
            style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_pad_gap="#space_sm"
            scrollable="false">
      <icon src="layers" size="sm" variant="success"/>
      <text_body text="Profiles" flex_grow="1"/>
    </lv_obj>
    <!-- Divider -->
    <divider_horizontal/>
    <!-- Profiles List (scrollable) -->
    <lv_obj name="profiles_list"
            width="100%" flex_grow="1" flex_flow="column" style_pad_all="#space_sm" style_pad_gap="#space_xs"
            scrollable="true">
      <!-- Profile rows 0-4. count="5" is a literal (matches
           BED_MESH_MAX_PROFILES in ui_panel_bed_mesh.h) so this expands once
           at load time and never rebuilds — the ordering constraint for
           subject-bound <repeat> does not apply here, and no_profiles_message
           may safely follow as a static sibling. ${i + 1} composes the
           1-based "hide until the count reaches this row" threshold each row
           needs; a literal ref_value per row was the unroll this repeat
           replaces. -->
      <repeat count="5">
        <!-- style_flex_track_place="center" is the fix for #1229 (name/range/
             delete icon not vertically centered): style_flex_cross_place
             only centers items WITHIN the flex track, not the track itself
             within this fixed-height row. Without it, any slack between the
             row height and the tallest child's content collects below the
             track instead of splitting evenly. ui_xml/header_bar.xml's root
             sets both attributes together for the same reason. -->
        <ui_card name="profile_row_${i}"
                 width="100%" height="#bed_mesh_profile_row_height" flex_flow="row" style_flex_cross_place="center"
                 style_flex_track_place="center" style_border_width="0" style_pad_left="#space_sm"
                 style_pad_right="#space_sm" style_pad_top="0" style_pad_bottom="0" style_pad_gap="#space_xs"
                 clickable="true" scrollable="false">
          <bind_flag_if_lt subject="bed_mesh_profile_count" flag="hidden" ref_value="${i + 1}"/>
          <bind_style_if_eq name="profile_row_active" subject="bed_mesh_profile_${i}_active" ref_value="1"/>
          <event_cb trigger="clicked" callback="on_profile_${i}_clicked"/>
          <!-- Name. long_mode="dots" so a name too long for whatever width
               this row ends up with (e.g. portrait_cards_row splitting the
               row with current_mesh_card, or a genuinely long saved profile
               name) truncates on one line with an ellipsis instead of
               wrapping — flex_grow="1" makes this the field that absorbs
               the squeeze, so it is the one that should truncate; the fixed-
               width range value next to it should not. width="1" alongside
               flex_grow="1" is required for dots to actually engage: LVGL's
               theme default width is "content" (size-to-fit), and dot
               truncation needs a definite width to truncate against — a
               content-sized label just grows/wraps instead, even when flex
               allocates it real pixels (verified: without width="1" this
               wrapped a long name across 5 lines rather than truncating).
               Same idiom as the flex column in ams_loaded_card.xml. -->
          <!-- height="content", not 100%: a full-height label box renders its
               glyphs at the top, leaving the name higher than the range and icons. -->
          <text_small name="profile_${i}_name"
                      width="1" height="content" bind_text="bed_mesh_profile_${i}_name" flex_grow="1"
                      style_text_color="#text" clickable="false" long_mode="dots" scrollable="false" event_bubble="true"/>
          <!-- Range -->
          <text_small name="profile_${i}_range"
                      width="50" bind_text="bed_mesh_profile_${i}_range" style_text_align="right" clickable="false"
                      event_bubble="true"/>
          <!-- Rename icon (only when active) -->
          <icon name="profile_${i}_rename"
                src="pencil" size="sm" color="#success" clickable="true" style_pad_all="#space_xs">
            <bind_flag_if_eq subject="bed_mesh_profile_${i}_active" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_profile_${i}_rename"/>
          </icon>
          <!-- Load icon (only when NOT active) -->
          <icon name="profile_${i}_load"
                src="arrow_up_circle" size="sm" variant="muted" clickable="true" style_pad_all="#space_xs">
            <bind_flag_if_eq subject="bed_mesh_profile_${i}_active" flag="hidden" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_profile_${i}_clicked"/>
          </icon>
          <!-- Delete icon (always visible) -->
          <icon name="profile_${i}_delete"
                src="trash_can_outline" size="sm" variant="danger" clickable="true" style_pad_all="#space_xs">
            <event_cb trigger="clicked" callback="on_profile_${i}_delete"/>
          </icon>
        </ui_card>
      </repeat>
      <!-- Empty state message (shown when no profiles) -->
      <lv_obj name="no_profiles_message" width="100%" height="content" style_pad_all="#space_md" scrollable="false">
        <bind_flag_if_gt subject="bed_mesh_profile_count" flag="hidden" ref_value="0"/>
        <text_small width="100%" text="No profiles available" style_text_align="center"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
