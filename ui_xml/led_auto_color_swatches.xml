<!-- The LED colour presets one LED Settings auto-state row picks from. Every
     row shows the same presets (led_auto_preset_color_<i>); each ring reads
     its own row's selected_subject. The click handler finds the row from the
     ctx_<state> container it sits in. -->
<component>
  <api>
    <prop name="selected_subject" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row_wrap" scrollable="false" style_pad_all="0"
        style_pad_gap="#led_swatch_gap" style_bg_opa="0" style_border_width="0">
    <!-- A subject-bound repeat must be its container's only child. -->
    <repeat count="led_auto_preset_count">
      <color_swatch name="led_auto_swatch_${i}"
                    index="${i}" color_subject="led_auto_preset_color_${i}" selected_subject="$selected_subject"
                    callback="led_auto_color_swatch_cb"/>
    </repeat>
  </view>
</component>
