<!-- Notification History Panel - Review past notifications -->
<component>
  <view name="notification_history_panel"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_bg_opa="255"
        style_bg_color="#screen_bg" style_border_width="0" style_pad_all="0" flex_flow="column">
    <!-- Header Bar (uses improved header_bar component) -->
    <header_bar name="overlay_header"
                title="Notifications" action_button_text="Clear All" action_button_height="#button_height"
                hide_action_button="false" action_button_2_text="Printer Events" action_button_2_icon="script_text"
                action_button_2_callback="on_open_printer_events" hide_action_button_2="false"/>
    <!-- Content Area (scrollable, hidden when no entries) -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_lg" style_pad_gap="#space_sm" flex_flow="column"
            scrollbar_mode="active">
      <bind_flag_if_eq subject="notification_has_entries" flag="hidden" ref_value="0"/>
      <!-- Sole child: rebuilt rows append to the end of their parent. -->
      <repeat count="notification_row_count">
        <notification_history_item severity_subject="notification_row_severity_${i}"
                                   title_subject="notification_row_title_${i}"
                                   message_subject="notification_row_message_${i}"
                                   has_message_subject="notification_row_has_message_${i}"
                                   timestamp_subject="notification_row_time_${i}"
                                   has_action_subject="notification_row_has_action_${i}"
                                   click_callback="on_notification_item_clicked" row_index="${i}"/>
      </repeat>
    </lv_obj>
    <!-- Empty state (shown when no notifications) -->
    <lv_obj name="empty_state"
            width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center"
            scrollable="false">
      <bind_flag_if_eq subject="notification_has_entries" flag="hidden" ref_value="1"/>
      <!-- Bell icon for empty state -->
      <icon src="bell" size="xl" variant="muted"/>
      <text_muted width="100%" text="No notifications" style_pad_top="#space_md" style_text_align="center"/>
    </lv_obj>
  </view>
</component>
