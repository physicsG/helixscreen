<!-- System Settings Overlay -->
<!-- Security, performance, telemetry, log level, restart, factory reset -->
<component>
  <view name="settings_system_overlay" extends="overlay_panel" title="System" bg_color="#screen_bg">
    <!-- Content Area - no padding, rows handle their own -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">
      <!-- All system settings live in a single grouped-list card (no section
           headers in this overlay); the card owns the horizontal inset. -->
      <setting_group name="group_system">
        <!-- ================================================================== -->
        <!-- SECURITY -->
        <!-- ================================================================== -->
        <setting_action_row name="row_security"
                            label="Security" icon="lock" description="Screen lock and PIN settings"
                            callback="on_security_clicked"/>
        <!-- ================================================================== -->
        <!-- PERFORMANCE (live host CPU/memory + per-MCU load) -->
        <!-- ================================================================== -->
        <lv_obj name="container_performance" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="perf_available" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_performance"
                              label="Performance" icon="speed" bind_description="perf_about_summary"
                              callback="on_system_performance_clicked"/>
        </lv_obj>
        <!-- ================================================================== -->
        <!-- TELEMETRY -->
        <!-- ================================================================== -->
        <setting_toggle_row name="row_telemetry"
                            label="Share Usage Data" icon="chart_line"
                            description="Anonymous data to help improve HelixScreen"
                            subject="settings_telemetry_enabled" callback="on_telemetry_changed"/>
        <setting_action_row name="row_telemetry_view_data"
                            label="View Telemetry Data" icon="list" description="See exactly what data will be sent"
                            callback="on_telemetry_view_data">
          <bind_flag_if_eq subject="settings_telemetry_enabled" flag="hidden" ref_value="0"/>
        </setting_action_row>
        <!-- ================================================================== -->
        <!-- LOG LEVEL -->
        <!-- ================================================================== -->
        <setting_dropdown_row name="row_log_level"
                              label="Log Level" icon="console" description="Set logging verbosity for troubleshooting"
                              options="Warn&#10;Info&#10;Debug&#10;Trace"
                              options_tag="Warn&#10;Info&#10;Debug&#10;Trace" bind_selected="settings_log_level"
                              callback="on_log_level_changed"/>
        <!-- ================================================================== -->
        <!-- RESTART -->
        <!-- ================================================================== -->
        <setting_action_row name="row_restart_helix"
                            label="Restart HelixScreen" icon="restart" description="Restart the display application"
                            callback="on_restart_helix_settings_clicked"/>
        <!-- ================================================================== -->
        <!-- FACTORY RESET -->
        <!-- ================================================================== -->
        <setting_action_row name="row_factory_reset"
                            label="Factory Reset" icon="refresh" description="Reset all settings and restart wizard"
                            callback="on_factory_reset_clicked"/>
      </setting_group>
    </lv_obj>
  </view>
</component>
