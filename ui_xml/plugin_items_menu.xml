<component>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="plugin_items_menu" extends="context_menu_backdrop">
    <!-- Width (fitted to the rows, PluginItemsMenu::card_width) and position set by C++ -->
    <context_menu_card title="Plugin actions">
      <!-- Plugin groups, or the empty state, populated by C++ -->
      <lv_obj name="plugin_rows"
              width="100%" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="0" style_bg_opa="0"
              style_border_width="0" scrollable="false"/>
    </context_menu_card>
  </view>
</component>
