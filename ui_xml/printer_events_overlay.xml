<!-- Printer Events: the printer event journal, newest first -->
<component>
  <view name="printer_events_overlay" extends="overlay_panel" title="Printer Events" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" flex_flow="column" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="0" style_pad_bottom="#space_lg" style_pad_gap="#space_sm" scrollable="false">
      <!-- Where the list comes from: the plugin's journal or this screen's own -->
      <text_muted name="events_source" width="100%" bind_text="printer_events_source"/>
      <!-- Rows container: sole child is the reactive repeat. Rebuilt rows append to the
           end of their parent, so nothing may follow it here. -->
      <lv_obj name="events_list"
              width="100%" flex_grow="1" scrollable="true" scrollbar_mode="active" flex_flow="column"
              style_pad_gap="#space_sm">
        <bind_flag_if_eq subject="printer_events_count" flag="hidden" ref_value="0"/>
        <repeat count="printer_events_count">
          <notification_history_item severity_subject="printer_event_severity_${i}"
                                     title_subject="printer_event_title_${i}"
                                     message_subject="printer_event_message_${i}"
                                     has_message_subject="printer_event_has_message_${i}"
                                     timestamp_subject="printer_event_time_${i}"/>
        </repeat>
      </lv_obj>
      <lv_obj name="empty_state"
              width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_md" hidden="true" scrollable="false">
        <bind_flag_if_not_eq subject="printer_events_count" flag="hidden" ref_value="0"/>
        <icon src="script_text" size="xl" variant="secondary"/>
        <text_muted width="content" text="No printer events yet" style_text_align="center">
          <bind_flag_if_eq subject="printer_events_unavailable" flag="hidden" ref_value="1"/>
        </text_muted>
        <!-- No plugin journal, and this build records none of its own -->
        <text_muted name="events_unavailable"
                    width="100%" text="Printer events need the HelixPrint plugin on this screen"
                    style_text_align="center" long_mode="wrap">
          <bind_flag_if_eq subject="printer_events_unavailable" flag="hidden" ref_value="0"/>
        </text_muted>
      </lv_obj>
    </lv_obj>
  </view>
</component>
