<!-- MICRO OVERRIDE of ui_xml/theme_editor_overlay.xml for 480x272 displays -->
<!-- Divergences from standard:
     - Uses #overlay_width_transient (vs default width)
     - Action buttons (Reset/Save As/Save) pinned OUTSIDE scroll area at bottom
       (standard has them inside the scroller)
     - Tighter padding: #space_sm/#space_xs (vs #space_md)
-->
<component>
  <view name="theme_editor_overlay" extends="overlay_panel" title="Edit Theme Colors" bg_color="#screen_bg">
    <!-- Content Area - no padding, rows handle their own -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="#space_sm" style_pad_right="#space_sm"
            style_pad_bottom="#space_xs" scrollable="true" flex_flow="column">
      <!-- ================================================================== -->
      <!-- THEME COLORS -->
      <!-- ================================================================== -->
      <setting_section_header title="THEME COLORS" icon="tune"/>
      <!-- One card per theme colour, two to a row. The card is the touch
           target (the swatch's index is its palette slot; the click handler
           reads it from user_data), kept at the touch-target floor by
           min_height so the smaller discs' cards still land a finger. -->
      <lv_obj name="theme_swatch_list"
              width="100%" height="content" scrollable="false" style_pad_left="#space_xs" style_pad_right="#space_xs"
              style_pad_top="0" style_pad_bottom="#space_xs" flex_flow="row_wrap" style_flex_main_place="space_between"
              style_pad_gap="#space_xxs">
        <repeat count="16">
          <ui_card width="49%"
                   height="content" flex_flow="row" style_pad_all="#space_xs" style_pad_gap="#space_xs"
                   style_radius="#border_radius_small" style_flex_cross_place="center"
                   style_min_height="#touch_target_min" clickable="true">
            <color_swatch name="swatch_${i}"
                          index="${i}" color_subject="theme_editor_role_color_${i}" size="#theme_swatch_size" reach="0"
                          hit="0" callback="on_theme_swatch_clicked"/>
            <lv_obj width="0"
                    height="content" flex_grow="1" flex_flow="column" style_pad_all="0" style_pad_gap="#space_xs"
                    scrollable="false" clickable="false" event_bubble="true">
              <text_small bind_text="swatch_${i}_desc" clickable="false" event_bubble="true"/>
            </lv_obj>
            <event_cb trigger="clicked" callback="on_theme_swatch_clicked" user_data="${i}"/>
          </ui_card>
        </repeat>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STYLE PROPERTIES -->
      <!-- ================================================================== -->
      <setting_section_header title="STYLE PROPERTIES" icon="tune_variant"/>

      <setting_slider_row name="row_border_radius"
                          label="Border Radius" icon="cube" description="Corner roundness" min="0" max="7" value="3"
                          min_icon="minus" max_icon="plus" callback="on_theme_property_changed"
                          user_data="border_radius"/>

      <setting_slider_row name="row_border_width"
                          label="Border Width" icon="ruler" description="Default border thickness" min="0" max="6"
                          value="1" min_icon="minus" max_icon="plus" callback="on_theme_property_changed"
                          user_data="border_width"/>

      <setting_slider_row name="row_border_opacity"
                          label="Border Opacity" icon="layers"
                          description="Border transparency (0 = invisible, 255 = solid)" min="0" max="255" value="128"
                          min_icon="minus" max_icon="plus" callback="on_theme_property_changed"
                          user_data="border_opacity"/>

      <setting_slider_row name="row_shadow_intensity"
                          label="Shadow Intensity" icon="animation" description="Drop shadow strength (0 = disabled)"
                          min="0" max="50" value="0" min_icon="minus" max_icon="plus"
                          callback="on_theme_property_changed" user_data="shadow"/>

    </lv_obj>
    <!-- Keep actions always visible on MICRO instead of pushing them below long scrollers -->
    <lv_obj name="action_buttons"
            width="100%" height="content" style_pad_left="#space_sm" style_pad_right="#space_sm"
            style_pad_top="#space_xs" style_pad_bottom="#space_xs" flex_flow="row" style_pad_gap="#space_xs"
            scrollable="false">
      <ui_button name="btn_reset" height="#button_height_sm" text="Reset" variant="secondary" flex_grow="1">
        <event_cb trigger="clicked" callback="on_theme_reset_clicked"/>
      </ui_button>
      <ui_button name="btn_save_as" height="#button_height_sm" text="Save As New" variant="secondary" flex_grow="1">
        <event_cb trigger="clicked" callback="on_theme_save_as_clicked"/>
      </ui_button>
      <ui_button name="btn_save" height="#button_height_sm" text="Save" variant="primary" flex_grow="1" disabled="true">
        <event_cb trigger="clicked" callback="on_theme_save_clicked"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
