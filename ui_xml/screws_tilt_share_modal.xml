<!-- Screws Tilt Share Modal - full result set as readable text + QR code -->
<!-- There is no OS clipboard on a printer; the QR is how values reach a phone. -->
<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <view name="screws_tilt_share_modal"
        extends="ui_dialog" width="90%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <!-- Content area -->
    <lv_obj name="share_content"
            width="100%" height="content" style_max_height="#dialog_content_max" style_pad_left="#space_lg"
            style_pad_right="#space_lg" style_pad_top="#space_sm" style_pad_bottom="#space_sm" flex_flow="column"
            style_flex_cross_place="center" style_pad_gap="#space_sm">
      <!-- Title row: icon + heading on one line to save vertical space -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
        <icon src="qrcode_scan" size="sm" variant="primary"/>
        <text_heading text="Bed Screw Results"/>
      </lv_obj>
      <!-- Body: screw rows on the left, QR on the right -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#space_md" scrollable="false">
        <!-- Dedicated container: a subject-bound <repeat> must be the only child -->
        <lv_obj name="share_rows"
                height="content" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
                scrollable="false">
          <repeat count="screws_share_count">
            <lv_obj name="share_row_${i}"
                    width="100%" height="content" style_bg_color="#section_bg_color" style_bg_opa="255" style_radius="6"
                    style_pad_all="#space_xs" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                    scrollable="false">
              <text_small name="share_name_${i}" bind_text="screws_share_${i}_name" flex_grow="1"/>
              <text_xs name="share_z_${i}" bind_text="screws_share_${i}_z" style_text_color="#text_muted"/>
              <text_small name="share_adj_${i}" bind_text="screws_share_${i}_adj"/>
            </lv_obj>
          </repeat>
        </lv_obj>
        <!-- QR code inserted programmatically for adaptive sizing -->
        <lv_obj name="qr_container" width="content" height="content" style_pad_all="0" style_border_width="0"/>
      </lv_obj>
      <text_xs width="100%"
               text="Scan with your phone to save these values" style_text_color="#text_muted" style_text_align="center"
               long_mode="wrap"/>
    </lv_obj>
    <modal_button_row hide_secondary="true"
                      primary_name="btn_ok" primary_text="Close" primary_callback="on_modal_ok_clicked"/>
  </view>
</component>
