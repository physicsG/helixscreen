<!-- Pause at Layer: schedule a pause into the running print through the
     printer's own macros (prestonbrown/helixscreen#1703). Opened from the
     layer readout on the print status panel; only reachable on printers that
     define the macros. Backdrop created by the Modal system. -->
<component>
  <view name="layer_pause_modal"
        extends="ui_dialog" width="70%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_md"
            scrollable="false">
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
        <icon src="pause" size="md" variant="primary"/>
        <text_heading text="Pause at Layer"/>
      </lv_obj>
      <text_body name="layer_pause_status"
                 width="100%" bind_text="layer_pause_status_text" long_mode="wrap" style_text_align="center"/>
      <ui_button name="btn_layer_pause_next" width="100%" icon="pause" text="Next Layer">
        <bind_state_if_not_eq subject="layer_pause_availability" state="disabled" ref_value="3"/>
        <event_cb trigger="clicked" callback="on_layer_pause_next"/>
      </ui_button>
      <ui_button name="btn_layer_pause_choose" width="100%" icon="layers" text="Choose Layer">
        <bind_state_if_not_eq subject="layer_pause_availability" state="disabled" ref_value="3"/>
        <event_cb trigger="clicked" callback="on_layer_pause_choose"/>
      </ui_button>
      <ui_button name="btn_layer_pause_cancel" width="100%" variant="danger" icon="close" text="Cancel Scheduled Pause">
        <bind_flag_if_eq subject="layer_pause_layer" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_layer_pause_cancel"/>
      </ui_button>
    </lv_obj>
    <modal_button_row hide_secondary="true"
                      primary_name="btn_layer_pause_close" primary_text="Close" primary_callback="on_layer_pause_close"/>
  </view>
</component>
