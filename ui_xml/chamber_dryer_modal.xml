<component>
  <api>
    <!-- "Heat the bed to 70°C", composed by ChamberDryerModal from the
         controller's bed-assist target. -->
    <prop name="bed_label" type="string" default=""/>
  </api>
  <!-- Start a chamber drying cycle: pick a preset (material, temperature and
       length, already clamped to what the appliance accepts) and optionally
       heat the bed alongside. The bed row hides on a printer with no heated
       bed. Backdrop created by the Modal system. -->
  <view name="chamber_dryer_modal"
        extends="ui_dialog" width="70%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_md">
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
        <icon src="heat_wave" size="md" variant="primary"/>
        <text_heading text="Start Drying"/>
      </lv_obj>
      <lv_dropdown name="preset_dropdown" width="100%"/>
      <lv_obj name="bed_assist_row"
              width="100%" height="content" flex_flow="row" style_pad_all="#space_sm" style_pad_gap="#space_sm"
              style_bg_opa="cover" style_bg_color="#card_bg" style_radius="#border_radius"
              style_flex_main_place="space_between" style_flex_cross_place="center" scrollable="false">
        <bind_flag_if_eq subject="printer_has_heater_bed" flag="hidden" ref_value="0"/>
        <text_body name="bed_assist_label" text="$bed_label" flex_grow="1" long_mode="wrap"/>
        <ui_switch name="bed_assist_switch" checked="true"/>
      </lv_obj>
    </lv_obj>
    <modal_button_row primary_text="Start" secondary_text="Cancel" primary_moves_machine="true"/>
  </view>
</component>
