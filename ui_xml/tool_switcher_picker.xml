<component>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="tool_switcher_picker" extends="context_menu_backdrop">
    <!-- Sized by the widget to its grid (fit_tool_picker_grid()), which may be
         wider than the tile; ContextMenu keeps the card on screen. The title is
         one word, the X carries the dismiss. -->
    <context_menu_card title="Tool" pad_all="#space_xs" pad_gap="#space_xs" hide_divider="true">
      <!-- Every head as a square cell, the rail's own segment at the picker's
           size. The grid scrolls under its bound max height where its rows
           do not fit the screen. -->
      <!-- SIZE_OK: the 2 px gap is kRailGap, which the widget measures cells with -->
      <lv_obj name="tool_list"
              height="content" flex_flow="row_wrap" style_pad_all="0" style_pad_gap="2" style_radius="#border_radius"
              style_clip_corner="true" style_bg_opa="0" style_border_width="0" scrollable="true" clickable="false">
        <bind_style_prop prop="width" subject="tool_switcher_picker_grid_w"/>
        <bind_style_prop prop="max_height" subject="tool_switcher_picker_grid_max_h"/>
        <repeat count="tool_switcher_heads">
          <tool_switcher_segment name="tool_picker_cell_${i}"
                                 index="${i}" size="tool_switcher_picker_cell" band_h="tool_switcher_picker_band_h"
                                 band_labelled="tool_switcher_picker_band_labelled"
                                 two_line="tool_switcher_picker_two_line" label_key="_pick" sub_key="_pick_sub"/>
        </repeat>
      </lv_obj>
      <!-- Park and the feeder under the grid, each half of it; either is
           absent where the backend does not offer it. The buttons grow to
           their icon and label, never under the touch floor, so their labels
           always show (tool_switcher_footer_labels is constantly 1). -->
      <!-- SIZE_OK: kRailGap -->
      <lv_obj name="tool_picker_footer"
              width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="2"
              style_radius="#border_radius" style_clip_corner="true" style_bg_opa="0" style_border_width="0"
              scrollable="false" clickable="false">
        <bind_flag_if cond="tool_switcher_park_supported eq 0 and tool_switcher_feeder_supported eq 0" flag="hidden"/>
        <tool_switcher_park_segment name="tool_park_btn"
                                    height="content" flex_grow="1" style_min_height="#touch_target_min"
                                    style_pad_ver="#space_xxs" two_line="tool_switcher_footer_labels">
          <bind_flag_if_eq subject="tool_switcher_park_supported" flag="hidden" ref_value="0"/>
        </tool_switcher_park_segment>
        <tool_switcher_feeder_segment name="tool_feeder_btn"
                                      height="content" flex_grow="1" style_min_height="#touch_target_min"
                                      style_pad_ver="#space_xxs" two_line="tool_switcher_footer_labels"
                                      label_form="tool_switcher_picker_feeder_label">
          <bind_flag_if_eq subject="tool_switcher_feeder_supported" flag="hidden" ref_value="0"/>
        </tool_switcher_feeder_segment>
      </lv_obj>
    </context_menu_card>
  </view>
</component>
