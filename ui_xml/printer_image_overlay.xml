<!-- Printer Image Selection Overlay: left list + right preview layout -->
<component>
  <view name="printer_image_overlay" extends="overlay_panel" title="Printer Image" bg_color="#screen_bg">
    <!-- Main content: left list + right preview in a ROW -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_sm" flex_flow="row" style_pad_gap="#space_sm"
            scrollable="false">

      <!-- LEFT: Scrollable list -->
      <lv_obj name="image_list_container"
              height="100%" flex_grow="5" flex_flow="column" style_pad_all="0" style_pad_top="#space_xs"
              scrollable="true" style_bg_opa="0" style_border_width="0">

        <setting_group name="group_auto_detect">
          <!-- Auto-detect option -->
          <setting_action_row name="row_auto_detect"
                              label="Auto-Detect" icon="sync" description="Use printer type to select image"
                              callback="on_printer_image_auto_detect"/>
        </setting_group>

        <!-- Shipped section header -->
        <setting_group name="group_shipped_images">
          <setting_group_header title="SHIPPED IMAGES"/>

          <!-- Shipped images list (populated dynamically in C++) -->
          <lv_obj name="shipped_images_list"
                  width="100%" height="content" scrollable="false" flex_flow="column" style_pad_all="0" style_bg_opa="0"
                  style_border_width="0"/>
        </setting_group>

        <!-- Custom section header -->
        <setting_group name="group_custom_images">
          <setting_group_header title="CUSTOM IMAGES"/>

          <!-- Custom images list -->
          <lv_obj name="custom_images_list"
                  width="100%" height="content" scrollable="false" flex_flow="column" style_pad_all="0" style_bg_opa="0"
                  style_border_width="0"/>
        </setting_group>

        <!-- USB section (conditionally visible) -->
        <lv_obj name="usb_import_section"
                width="100%" height="content" scrollable="false" flex_flow="column" style_pad_all="0" style_bg_opa="0"
                style_border_width="0" hidden="true">
          <bind_flag_if_eq subject="printer_image_usb_visible" flag="hidden" ref_value="0"/>
          <setting_group name="group_usb_images">
            <setting_group_header title="IMPORT FROM USB"/>
            <lv_obj name="usb_images_list"
                    width="100%" height="content" scrollable="false" flex_flow="column" style_pad_all="0"
                    style_bg_opa="0" style_border_width="0"/>
            <text_muted name="usb_status_label"
                        width="100%" bind_text="printer_image_usb_status" style_text_align="center"
                        style_pad_top="#space_sm"/>
          </setting_group>
        </lv_obj>

        <!-- Info note -->
        <info_note icon="info"
                   text="Place image files (PNG, JPEG, BMP, GIF) in config/custom_images/. Max size: 2048×2048 pixels."/>
      </lv_obj>

      <!-- RIGHT: Preview area -->
      <lv_obj name="preview_container"
              height="100%" flex_grow="4" flex_flow="column" style_pad_all="#space_sm" scrollable="false"
              style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#border_radius"
              style_flex_main_place="center" style_flex_cross_place="center">
        <!-- Preview image bound to subject -->
        <lv_image name="preview_image"
                  width="100%" flex_grow="1" bind_src="printer_image_preview_src" inner_align="contain" hidden="true">
          <bind_flag_if_eq subject="printer_image_has_preview" flag="hidden" ref_value="0"/>
        </lv_image>
        <!-- Placeholder when no preview -->
        <icon name="preview_placeholder" src="printer_3d" size="xl" variant="tertiary" hidden="true" align="center">
          <bind_flag_if_eq subject="printer_image_has_preview" flag="hidden" ref_value="1"/>
        </icon>
        <!-- Selected image name -->
        <text_body name="preview_label"
                   width="100%" bind_text="printer_image_preview_name" style_text_align="center"
                   style_pad_top="#space_xs"/>
        <!-- Tag parts / reset for the selected image. printer_image_tag_state:
             0 = cannot be tagged, 1 = no user tags, 2 = user tags in effect. -->
        <lv_obj name="tag_buttons"
                width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_top="#space_xs"
                style_pad_gap="#space_xs" scrollable="false" style_bg_opa="0" style_border_width="0" hidden="true">
          <bind_flag_if_eq subject="printer_image_tag_state" flag="hidden" ref_value="0"/>
          <ui_button name="btn_tag_parts"
                     height="#button_height_sm" flex_grow="1" variant="secondary" icon="target" text="Tag parts">
            <event_cb trigger="clicked" callback="on_printer_image_tag_parts"/>
          </ui_button>
          <ui_button name="btn_reset_tags"
                     height="#button_height_sm" flex_grow="1" variant="secondary" text="Reset tags" hidden="true">
            <bind_flag_if cond="printer_image_tag_state ne 2" flag="hidden"/>
            <event_cb trigger="clicked" callback="on_printer_image_reset_tags"/>
          </ui_button>
        </lv_obj>
      </lv_obj>

    </lv_obj>
  </view>
</component>
