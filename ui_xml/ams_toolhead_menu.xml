<component>
  <!-- The shared context-menu backdrop: full-screen dim, tap to dismiss through
       context_menu_backdrop_cb, which helix::ui::ContextMenu owns and routes to
       AmsToolheadMenu::on_backdrop_clicked(). -->
  <view name="toolhead_backdrop" extends="context_menu_backdrop">
    <!-- The card. Named context_menu (ContextMenu::menu_card_name()'s default)
         so the base can size and position it. Not the shared context_menu_card
         on purpose: that component titles itself imperatively (its users
         lv_label_set_text the header at runtime), while this header is BOUND to
         ams_toolhead_title so the C++ side never touches a label. -->
    <lv_obj name="context_menu"
            width="content" height="content" style_bg_color="#elevated_bg" style_bg_opa="255"
            style_radius="#border_radius" style_pad_all="#space_sm" style_pad_gap="#space_xs" flex_flow="column"
            style_flex_main_place="start" scrollable="false" clickable="true">
      <!-- Header names the head that was tapped, e.g. "Toolhead T3" -->
      <text_small name="menu_header" bind_text="ams_toolhead_title"/>
      <divider_horizontal color="#text_muted" opacity="38" clickable="false"/>
      <!-- Select: bring this head to the carriage (T{n}). Hidden for the head
           already mounted — the C++ side rewrites the label to carry its
           number. Mutually exclusive with Park. -->
      <ui_button name="btn_select_tool"
                 height="#button_height_sm" icon="arrow_left_right" text="Select" translation_tag="Select"
                 variant="ghost" clickable="true" style_flex_main_place="start">
        <bind_flag_if_eq subject="ams_toolhead_show_select" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="ams_toolhead_select_cb"/>
      </ui_button>
      <!-- Park: dock the mounted head, leaving its filament threaded. Shown
           only while THIS head is the mounted one. -->
      <ui_button name="btn_park_tool"
                 height="#button_height_sm" icon="home" text="Park" translation_tag="Park" variant="ghost"
                 clickable="true" style_flex_main_place="start">
        <bind_flag_if_eq subject="ams_toolhead_show_park" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="ams_toolhead_park_cb"/>
      </ui_button>
      <!-- Load / Unload are per-head and mutually exclusive: the backend's
           can_unload_from_toolhead() answers "filament is at THIS toolhead". -->
      <ui_button name="btn_load_tool"
                 height="#button_height_sm" icon="arrow_down" text="Load" translation_tag="Load" variant="ghost"
                 clickable="true" style_flex_main_place="start">
        <bind_flag_if_eq subject="ams_toolhead_show_load" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="ams_toolhead_load_cb"/>
      </ui_button>
      <ui_button name="btn_unload_tool"
                 height="#button_height_sm" icon="arrow_up" text="Unload" translation_tag="Unload" variant="ghost"
                 clickable="true" style_flex_main_place="start">
        <bind_flag_if_eq subject="ams_toolhead_show_unload" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="ams_toolhead_unload_cb"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
