<component>
  <!-- First-Run Wizard: Input Shaper Calibration (Optional) -->
  <!-- Offers accelerometer-based input shaper calibration when available -->
  <subjects>
    <!-- 1 where this layout shows the live sweep chart. Micro screens leave it
         under 80 px, too short to read, so there the step is progress only and
         WizardInputShaperStep does not stream the preview at all. -->
    <subject_expr name="wizard_input_shaper_chart_fits" expr="ui_breakpoint_v ge 1"/>
  </subjects>
  <consts>
    <!-- Step metadata (read by wizard orchestrator) -->
    <str name="step_title" value="Printer Setup: Input Shaping" value_tag="Printer Setup: Input Shaping"/>
    <str name="step_subtitle"
         value="Calibrate input shaping to reduce ringing artifacts in prints"
         value_tag="Calibrate input shaping to reduce ringing artifacts in prints"/>
    <int name="step_order" value="9"/>
  </consts>
  <view name="wizard_input_shaper_root"
        extends="lv_obj" width="100%" height="100%" style_bg_opa="0" style_border_width="0" style_pad_all="0"
        flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center">

    <!-- Main content card -->
    <ui_card width="100%"
             flex_grow="1" style_radius="#border_radius" style_pad_all="#space_lg" style_pad_gap="#space_md"
             flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center">

      <!-- Info section; hidden while calibrating and while the chart holds a
           curve, so the chart gets the card's height -->
      <lv_obj width="100%" flex_flow="column" style_pad_all="0" style_pad_gap="#space_sm">
        <bind_flag_if cond="wizard_input_shaper_active eq 1 or wizard_input_shaper_has_chart eq 1" flag="hidden"/>
        <text_body width="100%"
                   text="Input shaping reduces vibration artifacts (ringing) in your prints." style_text_align="center"/>
        <text_small width="100%"
                    text="An accelerometer was detected on your printer." style_text_align="center"
                    style_text_color="#text_muted"/>
      </lv_obj>

      <!-- Status display: one status line with Cancel beside it, then a thin bar -->
      <lv_obj width="100%"
              flex_flow="column" style_pad_all="0" style_pad_gap="#space_xs" style_flex_cross_place="center">
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_sm" scrollable="false">
          <text_body name="wizard_input_shaper_status_label"
                     flex_grow="1" bind_text="wizard_input_shaper_status" long_mode="dots"/>
          <!-- Spinner during the indeterminate analysis phase -->
          <spinner size="sm">
            <bind_flag_if_eq subject="wizard_input_shaper_indeterminate" flag="hidden" ref_value="0"/>
          </spinner>
          <!-- Cancel (visible only while calibration is running) sends M112 +
               firmware_restart: the gcode queue is blocked during the sweep, so
               that is the only reliable abort. -->
          <ui_button name="cancel_calibration_btn"
                     height="#button_height_sm" icon="alert_octagon" text="Stop" variant="danger">
            <event_cb trigger="clicked" callback="on_cancel_is_calibration"/>
            <bind_flag_if_eq subject="wizard_input_shaper_active" flag="hidden" ref_value="0"/>
          </ui_button>
        </lv_obj>

        <!-- Progress bar during the determinate sweep phases. Hidden during the
             offline analysis phase, which reports no percent: the spinner takes
             over and the status label counts elapsed seconds. -->
        <progress_bar name="calibration_progress_bar" width="100%" bind_value="wizard_input_shaper_progress">
          <bind_flag_if cond="wizard_input_shaper_progress eq 0 or wizard_input_shaper_indeterminate eq 1" flag="hidden"/>
        </progress_bar>

        <!-- Completion help text (shown only when calibration finishes, progress==100) -->
        <text_small width="100%"
                    text="Recalibrate or view detailed results anytime in Settings." style_text_align="center"
                    style_text_color="#text_muted">
          <bind_flag_if_not_eq subject="wizard_input_shaper_progress" flag="hidden" ref_value="100"/>
        </text_small>
      </lv_obj>

      <!-- Live response curve while each axis sweeps, then that axis's result,
           where it fits -->
      <lv_obj name="wizard_input_shaper_chart_host"
              width="100%" flex_grow="1" style_pad_all="0" style_radius="#border_radius" style_bg_color="#screen_bg"
              style_bg_opa="255" scrollable="false">
        <bind_flag_if cond="wizard_input_shaper_has_chart eq 0 or wizard_input_shaper_chart_fits eq 0" flag="hidden"/>
      </lv_obj>

      <!-- Spacer; the chart takes its room while it is shown -->
      <lv_obj flex_grow="1">
        <bind_flag_if cond="wizard_input_shaper_has_chart eq 1 and wizard_input_shaper_chart_fits eq 1" flag="hidden"/>
      </lv_obj>

      <!-- Start calibration button (centered, hidden once calibration started) -->
      <ui_button name="start_calibration_btn"
                 width="#wizard_button_width" height="#button_height" text="Start Calibration">
        <event_cb trigger="clicked" callback="on_start_is_calibration"/>
        <bind_flag_if_eq subject="wizard_input_shaper_started" flag="hidden" ref_value="1"/>
      </ui_button>

      <!-- Help text (hidden once calibration starts) -->
      <text_small width="100%"
                  text="You can skip this and calibrate later in Settings." style_text_align="center"
                  style_text_color="#text_muted">
        <bind_flag_if_eq subject="wizard_input_shaper_started" flag="hidden" ref_value="1"/>
      </text_small>

    </ui_card>
  </view>
</component>
