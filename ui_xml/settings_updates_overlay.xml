<!-- Updates Settings Overlay -->
<!-- Update channel, check and install, and the notices for installs that cannot self-update -->
<component>
  <view name="settings_updates_overlay" extends="overlay_panel" title="Updates" bg_color="#screen_bg">
    <!-- Content Area - no padding, rows handle their own -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">
      <setting_group name="group_updates">
        <!-- Update Channel, in two rows with complementary conditions. A dropdown's
             options are a static string, so the entries a user may choose from are
             picked by which row is on screen: everyone gets Stable/Beta, and Dev is
             added only with beta features unlocked, because it fetches from the
             arbitrary dev_url in the root-owned update_urls.json rather than from
             a published channel.
             Index 1 is Beta in both lists, so the shared callback and the stored
             /update/channel mean the same thing whichever row is visible.
             show_update_settings is part of both conditions because a firmware-managed
             install has no channel to pick: on_channel_changed() re-checks, and
             check_for_updates() short-circuits there, so the dropdown would persist a
             setting nothing reads and sit directly above "Managed by your firmware".
             ONE expression per row rather than two stacked bind_flag_if_eq — see the
             note on container_install_update below for why stacking silently loses.
             UpdatesSettingsOverlay::sync_update_channel_rows() seeds the selection from
             the effective channel instead of binding it to update_channel, because a
             locked install runs on Stable while the stored value may still say Dev. -->
        <lv_obj name="container_update_channel" width="100%" style_pad_all="0">
          <bind_flag_if cond="show_beta_features eq 0 and show_update_settings eq 1" flag="hidden" invert="true"/>
          <setting_dropdown_row name="row_update_channel"
                                label="Update Channel" icon="swap_vertical" options="Stable&#10;Beta"
                                options_tag="Stable&#10;Beta" hide_description="true"
                                callback="on_about_update_channel_changed"/>
        </lv_obj>
        <lv_obj name="container_update_channel_dev" width="100%" style_pad_all="0">
          <bind_flag_if cond="show_beta_features eq 1 and show_update_settings eq 1" flag="hidden" invert="true"/>
          <setting_dropdown_row name="row_update_channel_dev"
                                label="Update Channel" icon="swap_vertical" options="Stable&#10;Beta&#10;Dev"
                                options_tag="Stable&#10;Beta&#10;Dev" hide_description="true"
                                callback="on_about_update_channel_changed"/>
        </lv_obj>
        <!-- Check for Updates (reactive description shows available version) -->
        <lv_obj name="container_check_updates" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="show_update_settings" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_check_updates"
                              label="Check for Updates" icon="refresh" bind_description="update_version_text"
                              description_min_bp="0" callback="on_about_check_updates_clicked"/>
        </lv_obj>
        <!-- Install Update (visible only when an update is available AND this
             install can actually apply one — updates_unavailable means it cannot,
             in which case the notice below carries the instructions instead) -->
        <lv_obj name="container_install_update" width="100%" style_pad_all="0">
          <!-- ONE expression, not three stacked bind_flag_if_eq. Each stacked bind
               installs its own observer that writes the same `hidden` flag, so the
               last observer to fire wins and the other conditions are ignored. See
               LVGL9_XML_GUIDE.md, "Expression Conditionals". -->
          <bind_flag_if cond="show_update_settings eq 1 and updates_unavailable eq 0 and update_status eq 2"
                        flag="hidden" invert="true"/>
          <setting_action_row name="row_install_update"
                              label="Install Update" icon="download" description="" description_tag=""
                              callback="on_about_install_update_clicked"/>
        </lv_obj>
        <!-- Firmware-managed updates notice (replaces the check/install controls
             when HELIX_DISABLE_AUTO_UPDATES is set — updates come from the firmware) -->
        <lv_obj name="container_updates_firmware_managed" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="updates_firmware_managed" flag="hidden" ref_value="0"/>
          <setting_info_row name="row_updates_firmware_managed" label="Software Updates" icon="info_outline">
            <text_muted name="value" text="Managed by your firmware"/>
          </setting_info_row>
        </lv_obj>
        <!-- Cannot-install notice. Sits ALONGSIDE "Check for Updates" rather than
             replacing it: this install can still see that a new version exists, it
             just cannot apply one itself, so the row says what to do instead of
             saying nothing. Shown when the install tree isn't writable and updates
             are NOT firmware-managed. -->
        <lv_obj name="container_updates_unavailable" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="updates_unavailable" flag="hidden" ref_value="0"/>
          <!-- An action row, not an info row: the whole point is that the user can
               still act, and the modal behind it carries the command and a QR to
               the docs. A row that only states the problem is the dead end this
               replaces. description_min_bp="0" keeps the line on 480x272, where it
               is the only thing telling them what to do. -->
          <setting_action_row name="row_updates_unavailable"
                              label="Software Updates" icon="console"
                              description="Not available here. Update from a terminal." description_min_bp="0"
                              callback="on_about_updates_unavailable_clicked"/>
        </lv_obj>
      </setting_group>
    </lv_obj>
  </view>
</component>
