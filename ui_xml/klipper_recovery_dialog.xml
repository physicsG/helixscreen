<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <!-- Dialog card with warning border (backdrop created programmatically).
       style_max_height caps the card: Klipper shutdown reasons are arbitrarily long,
       and without it the card grew past both screen edges and lost its header and
       buttons on a 480x272 panel. The message caps at #dialog_content_recovery_max,
       measured on this card so chrome + cap lands 8px under the shared 85% card
       cap at every breakpoint (#1277). -->
  <view name="klipper_recovery_card"
        extends="ui_dialog" width="85%" height="content" style_max_height="85%" align="center" flex_flow="column"
        style_flex_main_place="start" style_pad_gap="0" style_border_width="2" style_border_color="#warning"
        scrollable="false">
    <!-- Header: icon, title, error code and close X share one row, which leaves the
         height for a multi-line message on the smallest panels. -->
    <lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_md" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
            scrollable="false">
      <icon src="alert_octagon" size="md" variant="warning"/>
      <!-- Title (driven by recovery_title subject) -->
      <text_heading name="recovery_title" bind_text="recovery_title" flex_grow="1"/>
      <!-- Klipper's JSON error code, e.g. "key1". Meaningless to a user reading the
           message, but worth keeping for bug reports, so it rides small and dim at the
           end of the row. Hidden via the companion int subject because bind_flag_if_eq
           compares ints and cannot test recovery_code for emptiness. -->
      <text_small name="recovery_code" bind_text="recovery_code" style_text_color="#text_muted">
        <bind_flag_if_eq subject="recovery_has_code" flag="hidden" ref_value="0"/>
      </text_small>
      <!-- Close X, sized like modal_header's, with its touch area widened into the
           row padding for the 24px micro size. Always shown: when disconnected it is
           the only way out of the dialog. -->
      <ui_button name="recovery_dismiss_btn"
                 width="#button_height_sm" height="#button_height_sm" icon="close" variant="ghost" focusable="false"
                 ext_click_area="#space_sm">
        <event_cb trigger="clicked" callback="recovery_dismiss_clicked"/>
      </ui_button>
    </lv_obj>
    <!-- Horizontal divider below header -->
    <divider_horizontal/>
    <!-- Message (driven by recovery_message subject). Capped and scrollable so a long
         shutdown reason scrolls within the card rather than growing it. -->
    <lv_obj name="recovery_message_scroll"
            width="100%" height="content" style_max_height="#dialog_content_recovery_max" style_pad_left="#space_lg"
            style_pad_right="#space_lg" style_pad_top="#space_md" style_pad_bottom="#space_md" scrollable="true"
            scroll_snap_y="none">
      <text_muted name="recovery_message" width="100%" bind_text="recovery_message" long_mode="wrap"/>
    </lv_obj>
    <!-- Restart actions, side by side rather than stacked. Wrapped so the whole row
         (including modal_button_row's own leading divider) hides as a unit when
         disconnected, leaving the header X as the only way out. -->
    <lv_obj name="recovery_restart_actions"
            width="100%" height="content" style_pad_all="0" style_pad_gap="0" style_bg_opa="0" style_border_width="0"
            scrollable="false">
      <bind_flag_if_eq subject="recovery_can_restart" flag="hidden" ref_value="0"/>
      <modal_button_row secondary_text="Firmware Restart"
                        secondary_variant="primary" secondary_icon="update"
                        secondary_callback="recovery_firmware_restart_clicked" primary_text="Restart Klipper"
                        primary_icon="refresh" primary_variant="warning"
                        primary_callback="recovery_restart_klipper_clicked"/>
    </lv_obj>
  </view>
</component>
