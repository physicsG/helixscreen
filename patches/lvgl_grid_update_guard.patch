 static uint32_t count_tracks(const int32_t * templ)
 {
+    /* Bounded walk: stop at GRID_MAX_TRACKS even if no LV_GRID_TEMPLATE_LAST is
+     * found, so a freed/garbage descriptor cannot run off the heap end. Callers
+     * (calc_cols/calc_rows) treat a return of GRID_MAX_TRACKS as invalid. */
     uint32_t i;
-    for(i = 0; templ[i] != LV_GRID_TEMPLATE_LAST; i++);
+    for(i = 0; i < GRID_MAX_TRACKS && templ[i] != LV_GRID_TEMPLATE_LAST; i++);
 
