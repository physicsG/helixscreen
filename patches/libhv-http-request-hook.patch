+// PATCH NOTE(helixscreen): one hook sees every client request once its URL is
+// parsed and before it is sent, so the host can attach a credential to the
+// requests bound for one server without every call site doing it. Covers
+// http_client_send, http_client_send_async and hv::HttpClient. NULL, the
+// default, does nothing.
+typedef void (*hv_http_request_hook_t)(HttpRequest* req);
+HV_EXPORT void hv_set_http_request_hook(hv_http_request_hook_t hook);
+
