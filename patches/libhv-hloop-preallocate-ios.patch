--- a/event/hloop.c
+++ b/event/hloop.c
@@ -332,8 +332,13 @@ static void hloop_init(hloop_t* loop) {
     heap_init(&loop->realtimers, timers_compare);
 
     // ios
-    // NOTE: io_array_init when hio_get -> io_array_resize
-    // io_array_init(&loop->ios, IO_ARRAY_INIT_SIZE);
+    // Allocated here, before the loop thread exists. A lazy first allocation in
+    // hio_get() runs on whichever thread gets there first, and a client's
