+    // creates the eventfd io on the loop thread: two first allocations, and the
+    // io one of them stored is lost. An fd at or past IO_ARRAY_INIT_SIZE still
+    // resizes lazily.
+    io_array_init(&loop->ios, IO_ARRAY_INIT_SIZE);
 
     // readbuf
     // NOTE: alloc readbuf when hio_use_loop_readbuf
