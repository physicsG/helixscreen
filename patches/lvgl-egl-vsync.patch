diff --git a/src/drivers/opengles/lv_opengles_egl.h b/src/drivers/opengles/lv_opengles_egl.h
--- a/src/drivers/opengles/lv_opengles_egl.h
+++ b/src/drivers/opengles/lv_opengles_egl.h
@@ -41,6 +41,15 @@
 lv_color_format_t lv_opengles_egl_color_format_from_egl_config(const lv_egl_config_t * config);
 
 void lv_opengles_egl_update(lv_opengles_egl_t * ctx);
+
+/**
+ * Choose whether presenting a frame waits for the previous one to reach the screen.
+ * The value is handed to the native flip callback on every lv_opengles_egl_update().
+ * @param ctx    the EGL context
+ * @param vsync  true: the flip callback waits for the pending flip; false: it does not wait
+ */
+void lv_opengles_egl_set_vsync(lv_opengles_egl_t * ctx, bool vsync);
+
 void lv_opengles_egl_clear(lv_opengles_egl_t * ctx);
 void lv_opengles_egl_context_destroy(lv_opengles_egl_t * ctx);
 
diff --git a/src/drivers/opengles/lv_opengles_egl.c b/src/drivers/opengles/lv_opengles_egl.c
--- a/src/drivers/opengles/lv_opengles_egl.c
+++ b/src/drivers/opengles/lv_opengles_egl.c
@@ -134,6 +134,14 @@
     ctx->interface.flip_cb(ctx->interface.driver_data, ctx->vsync);
 }
 
+void lv_opengles_egl_set_vsync(lv_opengles_egl_t * ctx, bool vsync)
+{
+    if(!ctx) {
+        return;
+    }
+    ctx->vsync = vsync;
+}
+
 
